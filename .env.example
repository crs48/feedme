# The default demo is usable without any accounts or secrets.
FEEDME_MODE=demo
PUBLIC_URL=http://127.0.0.1:4321
# On Render/Railway/Fly.io/Koyeb, omit PUBLIC_URL to use the generated domain.
# Set it explicitly for a custom domain. Never copy this loopback URL to a host.
HOST=127.0.0.1
PORT=4321
DATA_DIR=.data

# Four suggested tips in USD, in display order. The second amount is preselected.
# Supporters can still enter any amount from $1 to $1,000.
TIP_AMOUNTS=11,22,44,88

# Creator identity and default administrator. Change this to your own handle.
BLUESKY_HANDLE=crs.land

# Optional public creator index. Set to off to use direct graph/relay discovery only.
# No viewer identity or social graph is sent to this endpoint.
DIRECTORY_URL=https://feedme.fund/directory/v1.json
# Optional extra admins: comma-separated handles (with or without @) or DIDs.
# All admins can publish projects and read private financial records.
ADMIN_ACCOUNTS=

# Live mode also requires a public HTTPS origin and encryption.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional legacy DID override; leave unset when using BLUESKY_HANDLE.
# OWNER_DID=did:plc:…
DATA_ENCRYPTION_KEY=
HABITAT_URL=https://pear.habitat.network

# First use test mode keys. Configure a Connect webhook (connected accounts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: a stable 32+ character token for an external sync scheduler.
# pnpm start creates an in-process token and retries the outbox every 30 seconds.
SYNC_SECRET=

# Optional public directory relay. Personal network discovery reads creators' PDSs.
DISCOVERY_RELAY_URL=https://relay1.us-east.bsky.network

# Optional encrypted backups. Generate a DIFFERENT 32-byte hex key and save it
# in your password manager. Live backups run every 15 minutes with pnpm start.
BACKUP_ENCRYPTION_KEY=
# S3-compatible object storage. Use a unique prefix for this Feedme instance.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=feedme/
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PATH_STYLE=false
# Alternative: a mounted directory (same-server storage is not an off-server backup).
BACKUP_DIR=
