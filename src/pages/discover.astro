---
import Layout from '../layouts/Layout.astro';
import Avatar from '../components/Avatar.astro';
import Icon from '../components/Icon.astro';
import { discover, searchCreator, type DiscoveryResult } from '../lib/discovery';
import { connectionReason, type DiscoveryView } from '../lib/discovery-model';
import { recommendations } from '../lib/recommendations';
import { config } from '../lib/config';
const user = Astro.locals.user;
const views: [DiscoveryView, string][] = [['network','Your network'],['mutuals','Mutuals'],['following','Following'],['followers','Followers'],['extended','Friends of friends'],['explore','Explore']];
const requested = Astro.url.searchParams.get('view') || (user ? 'network' : 'explore');
const view = (views.some(([id]) => id === requested) ? requested : 'network') as DiscoveryView;
const page = Math.max(0, Math.min(100, Number.parseInt(Astro.url.searchParams.get('page') || '0') || 0));
const circle = Math.max(0, Math.min(166, Number.parseInt(Astro.url.searchParams.get('circle') || '0') || 0));
const q = (Astro.url.searchParams.get('q') || '').trim().slice(0,253);
const cursor = Astro.url.searchParams.get('cursor')?.slice(0,2048);
let result: DiscoveryResult = { cards: [], warnings: [], checked: 0, candidates: 0, more: false, demo: config().demo };
let saved = new Set<string>();
if (q || user || view === 'explore') {
  try { result = q ? await searchCreator(q, user?.did) : await discover(user?.did, view, page, circle, cursor); }
  catch { result.warnings.push('Discovery could not finish this time. Please retry or reconnect your Bluesky account.'); }
}
if (user) { try { saved = new Set((await recommendations(user.did)).map((r) => r.value.did)); } catch { result.warnings.push('Your saved recommendations could not be loaded.'); } }
const path = (params: Record<string,string>) => `/discover?${new URLSearchParams({ view, circle: String(circle), ...params })}`;
---
<Layout title="Discover creators" description="Find the people you already know, and the independent work they make possible." noindex>
  <section class="shell discovery-shell">
    <header class="discovery-heading"><div><span class="eyebrow">A little closer to your people</span><h1 class="display">Discover your people</h1><p>Find familiar faces on Feedme, follow their work, and introduce your audience to someone you believe in.</p></div><div class="discovery-symbol" aria-hidden="true"><Icon name="spark" size={38}/></div></header>
    <form action="/discover" method="get" class="discovery-search" role="search"><label class="sr-only" for="creator-search">Find a creator by Bluesky handle</label><span aria-hidden="true">@</span><input id="creator-search" name="q" value={q} placeholder="Bluesky handle" maxlength="253" autocomplete="off" spellcheck="false"/><button class="button" type="submit">Find creator</button></form>
    <nav class="discovery-tabs" aria-label="Discover creators">{views.map(([id,label]) => <a href={`/discover?view=${id}`} aria-current={!q && id === view ? 'page' : undefined}>{label}</a>)}</nav>
    {config().demo && <p class="discovery-info"><Icon name="spark" size={16}/><span>Sample creators and connections. Follows and recommendations here stay in this demo.</span></p>}
    {!user && view !== 'explore' && !q ? <div class="discovery-empty"><Icon name="user" size={32}/><h2>Your people are a good place to start.</h2><p>Sign in with Bluesky to find Feedme creators you follow, people who follow you, and friends of friends.</p><a href="/login?returnTo=/discover" class="button">Connect with Bluesky</a></div> : <>
      <div class="discovery-results-heading"><div><h2>{q ? `Results for ${q}` : views.find(([id]) => id === view)?.[1]}</h2><p>{q ? 'Looked up through their AT Protocol account.' : view === 'extended' ? 'People followed by your circle. A connection is a suggestion, not an endorsement.' : view === 'explore' ? 'Public Feedme profiles found through the directory and network relay. Each website is checked before linking.' : 'Your existing Bluesky connections, with a discoverable Feedme home.'}</p></div>{user && <a class="recommend-link" href="/recommendations">Your recommendations ↗</a>}<span class="discovery-count">{result.cards.length} {result.cards.length === 1 ? 'creator' : 'creators'}</span></div>
      {result.warnings.map((warning) => <p class="notice my-4" role="status">{warning}</p>)}
      {result.cards.length ? <div class="discovery-grid">{result.cards.map((creator) => <article class="creator-card"><div class="creator-card-top"><Avatar name={creator.name} src={creator.avatar} size={56}/><span class="connection-badge"><Icon name={creator.connection.following && creator.connection.follower ? 'heart' : 'user'} size={13}/>{q ? 'Feedme creator' : connectionReason(creator.connection)}</span></div><h3><a href={creator.url} rel="noopener noreferrer">{creator.name}<span class="sr-only"> · Visit Feedme</span></a></h3><a class="creator-handle" href={`https://bsky.app/profile/${encodeURIComponent(creator.did)}`} rel="noopener noreferrer">@{creator.handle}</a><p class="creator-bio">{creator.bio}</p>{creator.connection.via.length > 0 && <p class="creator-via">Through {creator.connection.via.map((p) => p.name).join(', ')}</p>}<div class="creator-card-actions"><a class="button secondary" href={creator.url} rel="noopener noreferrer">Visit Feedme <Icon name="arrow" size={14}/></a>{creator.did !== user?.did && <a class="recommend-link" href={`/recommend?did=${encodeURIComponent(creator.did)}`}>{saved.has(creator.did) ? 'Recommended ✓' : 'Recommend'}</a>}</div>{user && creator.did !== user.did && <form method="post" action="/api/social" class="creator-follow"><input type="hidden" name="action" value="follow"/><input type="hidden" name="kind" value="creator"/><input type="hidden" name="subject" value={creator.did}/><input type="hidden" name="enabled" value="yes"/><input type="hidden" name="returnTo" value="/discover"/><button disabled={creator.connection.following}>{creator.connection.following ? 'Following on Bluesky ✓' : 'Follow on Bluesky'}</button></form>}</article>)}</div> : <div class="discovery-empty"><Icon name="leaf" size={32}/><h2>{q ? 'No discoverable Feedme found yet.' : 'A little room to grow.'}</h2><p>{q ? 'They may not have published their Feedme profile, or may have chosen to stay out of discovery.' : result.more ? 'No Feedme profiles in this group. Check the next accounts to keep looking.' : 'No creators found in this search. Try another circle, explore the network, or look up a handle.'}</p>{!user && <a href="/login?returnTo=/discover" class="button">Find your Bluesky connections</a>}</div>}
      <nav class="discovery-pagination" aria-label="Discovery pages">{page > 0 && <a class="button secondary" href={path({ page: String(page-1) })}>← Previous accounts</a>}{result.more && <a class="button secondary" href={path({ page: String(page+1) })}>Check next 24 accounts →</a>}{result.nextCursor && <a class="button secondary" href={path({ cursor: result.nextCursor })}>More creators →</a>}{result.moreCircles && <a class="button secondary" href={path({ circle: String(circle+1), page: '0' })}>Search next circle →</a>}</nav>
      {!config().demo && !q && result.checked > 0 && <p class="discovery-footnote">Checked {result.checked} accounts in this group{view !== 'explore' ? ` · ${result.candidates} candidates in this search` : ''}. Profiles and connections are cached briefly. Recommendations are always your choice.</p>}
    </>}
    <aside class="discovery-bottom"><div><h2>Your corner belongs in the circle.</h2><p>Save your profile with discovery enabled so people can find your Feedme through AT Protocol and the public directory.</p></div><a class="button secondary" href="/studio/settings">Profile settings <Icon name="arrow" size={14}/></a></aside>
  </section>
</Layout>
<style>
.discovery-shell{padding-block:36px}.discovery-heading{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:30px}.discovery-heading h1{font-size:24px;line-height:1.08;letter-spacing:-.045em;margin:16px 0}.discovery-heading p{color:var(--color-muted);max-width:520px;font-size:15px;line-height:1.7}.discovery-symbol{width:64px;height:64px;border-radius:8px;background:#edf5ff;color:var(--color-primary);display:grid;place-items:center;margin-right:30px}.discovery-search{display:flex;align-items:center;gap:10px;background:white;border:1px solid var(--color-border);border-radius:8px;padding:6px 6px 6px 16px;max-width:610px;box-shadow:0 2px 4px #0a254008}.discovery-search>span{color:var(--color-muted)}.discovery-search input{border:0;box-shadow:none;outline-offset:2px;background:none;min-width:0;flex:1;font-size:16px;padding:10px 0}.discovery-search .button{flex-shrink:0}.discovery-tabs{display:flex;gap:8px;overflow-x:auto;padding:26px 0 18px;margin-bottom:8px;border-bottom:1px solid var(--color-border)}.discovery-tabs a{white-space:nowrap;font-size:13px;font-weight:550;border-radius:8px;padding:11px 14px;color:var(--color-muted);min-height:44px}.discovery-tabs a[aria-current]{background:#eaf3ff;color:#0759d4}.discovery-tabs a:hover{background:var(--color-surface)}.discovery-info{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--color-muted);padding:12px 0}.discovery-results-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:26px 0 22px}.discovery-results-heading h2{font-size:18px;font-weight:650;letter-spacing:-.03em}.discovery-results-heading p{font-size:13px;line-height:1.6;color:var(--color-muted);margin-top:5px}.discovery-count{font-size:12px;white-space:nowrap;color:var(--color-muted)}.discovery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.creator-card{border:1px solid var(--color-border);background:white;border-radius:8px;padding:22px;display:flex;flex-direction:column;box-shadow:0 2px 6px #0a254004;transition:border-color .15s,box-shadow .15s;min-width:0}.creator-card:hover{border-color:#b9d4fb;box-shadow:0 4px 15px #0a254008}.creator-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:17px}.connection-badge{display:flex;align-items:center;gap:5px;font-size:10px;line-height:1.5;background:#eff6ff;color:#245aa2;border-radius:6px;padding:5px 7px;max-width:160px}.connection-badge svg{flex-shrink:0}.creator-card h3{font-size:18px;letter-spacing:-.025em;font-weight:650;overflow-wrap:anywhere}.creator-handle{font-size:12px;color:var(--color-muted);margin-top:3px;overflow-wrap:anywhere}.creator-bio{font-size:13px;line-height:1.7;color:#536174;margin:16px 0;flex:1;overflow-wrap:anywhere}.creator-via{font-size:11px;color:var(--color-muted);margin-bottom:14px}.creator-card-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.creator-card-actions .button{font-size:12px;padding:10px 12px}.recommend-link{white-space:nowrap;font-size:12px;font-weight:600;color:#0866ff;min-height:44px;display:inline-flex;align-items:center}.creator-follow{border-top:1px solid #edf0f4;margin-top:14px;padding-top:6px}.creator-follow button{font-size:12px;min-height:44px;color:#0866ff}.creator-follow button:disabled{color:var(--color-muted);cursor:default}.discovery-empty{text-align:center;padding:48px 20px;border:1px dashed #d8e0ea;border-radius:8px;margin-top:22px;display:flex;align-items:center;flex-direction:column;gap:15px}.discovery-empty>svg{color:#0866ff}.discovery-empty h2{font-size:18px;font-weight:600;letter-spacing:-.03em}.discovery-empty p{max-width:450px;font-size:14px;line-height:1.7;color:var(--color-muted)}.discovery-pagination{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.discovery-footnote{font-size:12px;line-height:1.7;color:var(--color-muted);margin-top:18px}.discovery-bottom{display:flex;align-items:center;justify-content:space-between;gap:24px;border-top:1px solid var(--color-border);margin-top:42px;padding-top:26px}.discovery-bottom h2{font-size:16px;font-weight:600}.discovery-bottom p{font-size:13px;line-height:1.7;color:var(--color-muted);max-width:520px;margin-top:5px}.discovery-bottom .button{white-space:nowrap}@media(max-width:1000px){.discovery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.discovery-shell{padding-block:30px}.discovery-symbol{display:none}.discovery-grid{grid-template-columns:1fr}.discovery-heading p{font-size:14px}.discovery-tabs{margin-right:0;padding-right:0}.discovery-count{display:none}.discovery-results-heading{align-items:flex-start;flex-direction:column;gap:10px}.discovery-search .button{padding:10px 12px;font-size:12px}.discovery-bottom{align-items:flex-start;flex-direction:column}.creator-card{padding:20px}.connection-badge{max-width:190px}}
</style>
