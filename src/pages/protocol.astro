---
import Layout from '../layouts/Layout.astro';
import { PROTOCOL_AUTHORITY, protocolSchemas } from '../lib/protocol';
import { config } from '../lib/config';
---
<Layout title="Feedme protocol"><section class="shell py-12"><div class="panel mx-auto max-w-2xl"><span class="eyebrow">An open network of independent creators</span><h1 class="display text-3xl mt-4 mb-4">The Feedme protocol</h1><p class="muted text-sm mb-6">Profiles, projects, and recommendations use the fund.feedme namespace. Each creator keeps their public records in their own AT Protocol repository. Private receipts belong in Habitat.</p><ul class="space-y-3 mb-7">{protocolSchemas.map((schema) => <li><a class="text-sm underline break-all" href={`/lexicons/${schema.id}.json`}>{schema.id}</a></li>)}</ul><p class="text-sm mb-3">Schema authority: <a class="underline" href="https://bsky.app/profile/feedme.fund">@feedme.fund</a></p><p class="text-xs muted break-all mb-6">{PROTOCOL_AUTHORITY}</p><h2 class="section-title mb-3">DNS publication</h2><p class="text-sm muted mb-3">The domain operator must add this TXT record. Publishing schemas below does not change DNS.</p><pre class="text-xs overflow-x-auto bg-slate-50 p-4 rounded-lg mb-6">_lexicon.feedme.fund TXT did={PROTOCOL_AUTHORITY}</pre>
{Astro.locals.user?.did === PROTOCOL_AUTHORITY && !config().demo ? <form method="post" action="/api/social"><input type="hidden" name="action" value="publish-protocol"/><input type="hidden" name="returnTo" value="/protocol"/><label class="flex gap-3 text-sm mb-4"><input type="checkbox" name="consent" value="public" required/><span>Publish these {protocolSchemas.length} schemas to @feedme.fund’s public repository.</span></label><button class="button">Publish official schemas</button></form> : <p class="notice">To publish schemas, use a live HTTPS instance and <a class="underline" href="/login?returnTo=/protocol">sign in as @feedme.fund</a>. Other accounts can use the protocol without publishing its schemas.</p>}
</div></section></Layout>
