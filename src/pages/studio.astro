---
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminFilters from '../components/AdminFilters.astro';
import EarningsChart from '../components/EarningsChart.astro';
import AdminPayments from '../components/AdminPayments.astro';
import { payments, projects } from '../lib/repository';
import { adminReport, selectedPayments, summarizePayments, earningsSeries, projectPerformance, recurringSummary } from '../lib/analytics';
import { money } from '../lib/model';
import { getDb, listRecords, pendingWrites } from '../lib/db';
import type { Subscription } from '../lib/recurring';
import { privateSpace } from '../lib/habitat';
import { connectedAccount } from '../lib/payments';
import { config } from '../lib/config';
const list = projects(true);
const all = payments();
const { query, error } = adminReport(Astro.url.searchParams);
const records = selectedPayments(all, query);
const stats = summarizePayments(records);
const performance = projectPerformance(records, list).filter((p) => !query.project || p.id === query.project);
const recurring = recurringSummary(all, listRecords<Subscription>(getDb(), 'subscription'), query.project);
const queue = pendingWrites(getDb());
---
<AdminLayout title="Overview" description="A clear view of the support behind your work.">
  <a slot="actions" href="/studio/projects/new" class="button">+ Create project</a>
  {error && <p class="notice error">{error}</p>}
  <div class="admin-summary"><AdminFilters query={query} projects={list}/>
  <div class="admin-kpis"><section class="admin-kpi"><h2>Net support</h2><strong>{money(stats.net)}</strong><p>{money(stats.gross)} gross · before fees</p></section><section class="admin-kpi"><h2>Confirmed payments</h2><strong>{stats.count}</strong><p>{money(stats.average)} average net tip</p></section><section class="admin-kpi"><h2>Named supporters</h2><strong>{stats.knownSupporters}</strong><p>+ {stats.anonymousPayments} anonymous / guest tips</p></section><section class="admin-kpi"><h2>Monthly recurring support</h2><strong>{money(recurring.monthly)}</strong><p>{recurring.active} active subscriptions · current run rate</p></section></div>
  </div>
  <div class="admin-grid"><div><EarningsChart series={earningsSeries(records, query)} interval={query.interval}/><section class="admin-card"><div class="admin-card-heading"><h2>Project performance</h2><a class="admin-link" href="/studio/projects">Manage projects →</a></div>{performance.map((p) => <div class="admin-progress-row"><div><a class="admin-link" href={`/studio/projects/${p.id}`}>{p.title}</a><strong>{money(p.net)}</strong></div><div class="progress"><span style={`width:${stats.net ? p.net / stats.net * 100 : 0}%`}></span></div><p class="admin-help mt-1">{p.count} confirmed contributions · {stats.net ? Math.round(p.net / stats.net * 100) : 0}% of net support</p></div>)}{!performance.length && <p class="admin-empty">Create your first project to give people something to support.</p>}</section></div>
  <aside><section class="admin-card"><div class="admin-card-heading"><h2>Payment health</h2></div><dl><div class="admin-stat-line"><dt>Refunded</dt><dd>{money(stats.refunded)}</dd></div><div class="admin-stat-line"><dt>Disputed · excluded</dt><dd>{money(stats.disputed)}</dd></div><div class="admin-stat-line"><dt>Pending payments</dt><dd>{stats.pending}</dd></div><div class="admin-stat-line"><dt>Failed payments</dt><dd>{stats.failed}</dd></div><div class="admin-stat-line"><dt>Subscriptions past due · now</dt><dd>{recurring.pastDue}</dd></div><div class="admin-stat-line"><dt>Ending after this billing period</dt><dd>{recurring.ending}</dd></div></dl><p class="admin-help mt-4">Recurring support includes monthly commitments plus one twelfth of yearly commitments. It is an estimate, not collected income.</p></section>
  <section class="admin-card"><div class="admin-card-heading"><h2>Your workspace</h2></div><dl><div class="admin-stat-line"><dt>Published projects</dt><dd>{list.filter((p) => p.status === 'active').length}</dd></div><div class="admin-stat-line"><dt>Private drafts</dt><dd>{list.filter((p) => p.status === 'draft').length}</dd></div><div class="admin-stat-line"><dt>Stripe account</dt><dd>{config().demo ? 'Demo' : connectedAccount() ? 'Linked' : 'Set up needed'}</dd></div><div class="admin-stat-line"><dt>Habitat private storage</dt><dd>{privateSpace() ? 'Connected' : 'Set up needed'}</dd></div><div class="admin-stat-line"><dt>Records awaiting sync</dt><dd>{queue.length}{queue.length === 50 ? '+' : ''}</dd></div></dl><a class="admin-link mt-3" href="/studio/settings">Manage connections →</a></section></aside></div>
  <section class="admin-card"><div class="admin-card-heading"><h2>Recent payments</h2><a class="admin-link" href={`/studio/payments?${Astro.url.searchParams}`}>View payment history →</a></div><AdminPayments records={records.slice(0,5)} projects={list}/></section>
</AdminLayout>
