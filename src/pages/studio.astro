---
import { randomUUID } from 'node:crypto';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectForm from '../components/ProjectForm.astro';
import { isOwner } from '../lib/auth';
import { config } from '../lib/config';
import { profile, projects, supports, totals } from '../lib/repository';
import { money, netSupport } from '../lib/model';
import { privateSpace } from '../lib/habitat';
import { connectedAccount } from '../lib/payments';
import { getDb, pendingWrites } from '../lib/db';
if (!isOwner(Astro.locals.user)) return Astro.redirect('/login?returnTo=/studio');
const cfg = config();
const p = profile();
const list = projects(true);
const total = totals(undefined, false);
const queue = pendingWrites(getDb());
const records = supports();
---
<Layout title="Your studio" noindex>
  <section class="shell py-10"><div class="flex justify-between gap-5 items-start"><div><span class="eyebrow">A little space to tend your work</span><h1 class="serif text-5xl mt-3">Your studio.</h1></div><form method="post" action="/auth/logout"><button class="button secondary">Sign out</button></form></div>
    <div class="grid md:grid-cols-3 gap-5 mt-8 mb-10"><div class="panel"><span class="eyebrow">Total support</span><p class="serif text-4xl mt-2">{money(total.amount)}</p><p class="muted text-xs mt-1">All visibility settings · after refunds</p></div><div class="panel"><span class="eyebrow">Votes of encouragement</span><p class="serif text-4xl mt-2">{total.count}</p><p class="muted text-xs mt-1">Confirmed one-time tips</p></div><div class="panel"><span class="eyebrow">Room to grow</span><p class="serif text-4xl mt-2">{list.filter((x) => x.status === 'active').length}</p><p class="muted text-xs mt-1">Active projects & practices</p></div></div>
    {cfg.demo && <div class="notice">You’re tending a shared demo garden. Changes persist here; real account connections and payments stay off.</div>}
    <div class="studio-columns"><div>
      <h2 class="section-title mb-5">Where the energy is going</h2><div class="panel mb-8">{list.map((item) => { const t = totals(item.id, false); return <div class="energy-row"><div class="flex justify-between gap-4 text-sm"><span>{item.title}</span><strong>{money(t.amount)}</strong></div><div class="progress my-2"><span style={`width:${total.amount ? t.amount / total.amount * 100 : 0}%`}></span></div><span class="muted text-[10px]">{t.count} tips · {item.status}</span></div>; })}{!list.length && <p class="muted text-sm">Start a project to give your supporters somewhere to send their energy.</p>}</div>
      <h2 class="section-title mb-5">Your projects</h2>{list.map((item) => <details class="panel mb-4"><summary class="flex justify-between items-center gap-4"><span>{item.title}</span><span class="tag">{item.status} · edit</span></summary><div class="mt-6"><ProjectForm project={item}/></div></details>)}
      <details class="panel mb-8"><summary class="flex items-center gap-3 font-medium"><Icon name="plus"/>Make room for something new</summary><div class="mt-6"><ProjectForm/></div></details>
      <h2 class="section-title mb-5">Your project log</h2><form class="panel mb-5" method="post" action="/api/studio"><input type="hidden" name="action" value="post-update"/><input type="hidden" name="requestId" value={randomUUID()}/><p class="text-xs muted mb-5">Publish a native Bluesky post. It appears in your project log, your followers’ timelines, and Feedme project updates.</p><label class="field">Project<select name="projectId" required>{list.filter((x) => x.status !== 'archived').map((item) => <option value={item.id}>{item.title}</option>)}</select></label><label class="field">What’s happening?<textarea name="text" minlength="3" maxlength="3000" required placeholder="A small win, a new question, a moment worth sharing…"></textarea></label><p class="text-xs muted mb-5">Up to 300 characters. A project link card is included.</p><button class="button" disabled={!list.length}>{cfg.demo ? 'Try a demo project post' : 'Publish to Bluesky & project log'}</button></form>
      <details class="panel mb-8"><summary class="font-medium">Add a Bluesky post with photos or video</summary><form method="post" action="/api/studio" class="mt-5"><input type="hidden" name="action" value="link-post"/><p class="text-xs muted mb-5">Create a post in Bluesky with your photos or video, then paste its link here. The project log displays the original post and its media. Only this creator’s posts can be added.</p><label class="field">Project<select name="projectId" required>{list.filter((x) => x.status !== 'archived').map((item) => <option value={item.id}>{item.title}</option>)}</select></label><label class="field">Bluesky post link<input name="postUrl" required placeholder="https://bsky.app/profile/you/post/…"/></label><button class="button secondary" disabled={cfg.demo || !list.length}>Add to project log</button></form></details>
      <h2 class="section-title mb-5">The people behind the possibilities</h2><div class="panel overflow-x-auto"><table class="support-table"><thead><tr><th>Project / supporter</th><th>Support</th><th>Visibility</th></tr></thead><tbody>{records.slice(0, 50).map((s) => <tr><td><span class="block text-xs font-medium">{list.find((x) => x.id === s.projectId)?.title || s.projectId}</span><span class="block text-[10px] muted break-all">{s.visibility === 'anonymous' ? 'An anonymous kind human' : s.supporterDid}</span>{s.note && <p class="text-xs mt-2">“{s.note}”</p>}</td><td class="whitespace-nowrap text-xs">{money(netSupport(s))}<span class="block text-[10px] muted">{s.status}</span></td><td><span class="tag">{s.visibility}</span></td></tr>)}</tbody></table>{!records.length && <p class="muted text-xs">Your first supporter could be just around the corner.</p>}</div>
    </div><aside>
      <h2 class="section-title mb-5">Make yourself at home</h2><details class="panel mb-5" open><summary class="font-medium">Your profile</summary><form class="mt-5" action="/api/studio" method="post"><input type="hidden" name="action" value="profile"/><label class="field">Name<input name="name" value={p.name} maxlength="80" required/></label><label class="field">Display handle<input name="handle" value={p.handle} maxlength="253"/></label><label class="field">A few words about you<textarea name="bio" maxlength="500" minlength="3" required>{p.bio}</textarea></label><label class="field">Your part of the world<input name="location" value={p.location} maxlength="80"/></label><label class="field">Website<input name="website" type="url" value={p.website}/></label><button class="button secondary full">Save profile</button></form></details>
      <div class="panel mb-5"><p class="eyebrow mb-2">Your connections</p><h3 class="section-title mb-5">Roots in the open web.</h3><div class="connection"><span>AT Protocol identity</span><strong>{cfg.demo ? 'Demo identity' : 'Signed in'}</strong></div><div class="connection"><span>Habitat private space</span><strong>{privateSpace() ? 'Created' : 'Not connected'}</strong></div><form method="post" action="/api/studio" class="mt-3 mb-5"><input type="hidden" name="action" value="space"/><button class="button secondary full" disabled={cfg.demo || Boolean(privateSpace())}>Create private storage</button></form><div class="connection"><span>Stripe account</span><strong>{connectedAccount() ? 'Connected' : 'Not connected'}</strong></div><form method="post" action="/api/studio" class="mt-3"><input type="hidden" name="action" value="stripe"/><button class="button secondary full" disabled={cfg.demo}>{connectedAccount() ? 'Continue Stripe onboarding' : 'Connect with Stripe'}</button></form><p class="text-[10px] muted mt-4">Stripe handles banking details and verifies payment readiness at checkout.</p></div>
      <div class="panel mb-5"><p class="eyebrow mb-2">Your data, on your terms</p><h3 class="section-title mb-3">Keep things in sync.</h3><p class="muted text-xs mb-4">{queue.length ? `${queue.length}${queue.length === 50 ? '+' : ''} records waiting for Habitat and your public PDS.` : 'No records waiting to sync.'}</p><form method="post" action="/api/studio"><input type="hidden" name="action" value="sync"/><button class="button secondary full">Sync records</button></form>{queue.some((q) => q.attempts > 0) && <p class="text-xs text-orange-800 mt-4">A sync attempt failed. Reconnect your identity if needed, then retry. The records remain queued.</p>}</div>
      <details class="panel"><summary class="font-medium">Grow your circle</summary><form action="/api/studio" method="post" class="mt-5"><input type="hidden" name="action" value="friend"/><label class="field">Person or project<input name="name" maxlength="80" required/></label><label class="field">Their support page<input name="url" type="url" placeholder="https://…" required/></label><label class="field">Their DID (optional)<input name="did" placeholder="did:plc:…"/></label><label class="field">Why you love their work<textarea name="description" maxlength="180" minlength="3" required></textarea></label><button class="button secondary full">Add to your circle</button></form></details>
    </aside></div>
  </section>
</Layout>
<style>
  .studio-columns { display:grid; grid-template-columns:minmax(0,1.6fr) minmax(0,1fr); gap:35px; }
  .energy-row + .energy-row { border-top:1px solid #e5e8dd; margin-top:18px; padding-top:18px; }
  .connection { display:flex; justify-content:space-between; gap:8px; font-size:11px; padding:12px 0; border-bottom:1px solid #e7eadd; }
  .connection strong { font-weight:500; color:#728764; }
  .support-table { width:100%; text-align:left; }
  .support-table th { font-size:10px; font-weight:500; color:#77846c; padding-bottom:15px; }
  .support-table td { vertical-align:top; padding:15px 10px 15px 0; border-top:1px solid #e8ebdf; }
  button:disabled { opacity:.5; cursor:not-allowed; }
  @media(max-width:850px) { .studio-columns { grid-template-columns:1fr; } }
</style>
