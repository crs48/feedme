---
import PickVisit from '../components/PickVisit.astro';
import { libcardProfile, loadLibcardSnapshot } from '../lib/libcard';
import { creatorCircle } from '../lib/creator-circle';
import Layout from '../layouts/Layout.astro';
import Creator from '../components/Creator.astro';
import SupportAllocator from '../components/SupportAllocator.astro';
import SupportTimeline from '../components/SupportTimeline.astro';
import Icon from '../components/Icon.astro';
import Avatar from '../components/Avatar.astro';
import { config } from '../lib/config';
import { demoPerson } from '../lib/demo-media';
import { profile, projects, totals } from '../lib/repository';
import { refreshCreatorBluesky } from '../lib/creator-bluesky';
const [snapshot] = await Promise.all([loadLibcardSnapshot(), refreshCreatorBluesky()]);
if (config().libcard && !snapshot) Astro.response.status = 503;
const p = libcardProfile(profile(), snapshot);
const list = projects();
const t = totals();
const circle = creatorCircle();
---
<Layout title={`${p.name} — projects & support`} description={p.bio}>
  <Creator/>
  <div class="shell"><>{config().libcard ? <PickVisit/> : <SupportAllocator projects={list} creatorName={p.name}/>}</></div>
  <section class="shell support-note"><Icon name="heart" size={18}/><p><strong>Support goes directly to the creator.</strong> Every tip helps, whether or not a project reaches its aspiration.</p><span>{t.count} public {t.count === 1 ? 'tip' : 'tips'}</span></section>
  {circle.length > 0 && <><section class="shell circle-teaser"><div><h2 class="section-title">People worth knowing</h2><p class="muted mt-2">A few friends and projects I recommend.</p></div><a class="button secondary social" href="/circle">Explore my circle <Icon name="arrow" size={15}/></a></section>
  <div class="shell teaser-cards">{circle.slice(0, 2).map((f) => <a href={f.url} rel="noopener noreferrer" class="teaser-card"><Avatar name={f.name} src={config().demo ? demoPerson(f.did)?.avatar : undefined} size={44}/><span class="min-w-0"><strong>{f.name}</strong><span class="block muted mt-1">{f.description}</span></span><span class="ml-auto muted" aria-hidden="true">↗</span></a>)}</div></>}
  <div class="shell"><SupportTimeline/></div>
</Layout>
<style>
  .support-note { display: flex; align-items: center; gap: 14px; padding: 20px 0; margin-top: 12px; font-size: 12px; color: var(--color-muted); border-bottom: 1px solid var(--color-border); }
  .support-note strong { font-weight: 500; color: var(--color-ink); }
  .support-note > span { margin-left: auto; white-space: nowrap; }
  .circle-teaser { margin-top: 40px; display: flex; align-items: center; justify-content: space-between; gap: 20px; font-size: 14px; }
  .teaser-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
  .teaser-card { border: 1px solid var(--color-border); border-radius: 14px; padding: 20px; display: flex; align-items: center; gap: 14px; background: white; font-size: 13px; transition: border-color .15s; }
  .teaser-card:hover { border-color: #83b8ff; }
  .teaser-card strong { font-size: 14px; font-weight: 600; }
  @media(max-width:950px) { .support-note > span { display: none; } }
  @media(max-width:600px) { .support-note { align-items: flex-start; } .support-note svg { margin-top: 3px; } .circle-teaser { align-items: flex-start; flex-direction: column; gap: 16px; margin-top: 32px; } .teaser-cards { grid-template-columns: 1fr; gap: 12px; } }
</style>
