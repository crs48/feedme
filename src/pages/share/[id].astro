---
import Layout from '../../layouts/Layout.astro';
import AspirationProgress from '../../components/AspirationProgress.astro';
import FollowButton from '../../components/FollowButton.astro';
import { config } from '../../lib/config';
import { percentageLabel } from '../../lib/aspiration';
import { money } from '../../lib/model';
import { supportShare } from '../../lib/support-shares';
const card = supportShare(Astro.params.id);
if (!card) return new Response('Support card unavailable.', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
const cfg = config();
const imageUrl = `${cfg.origin}/share/${Astro.params.id}.png`;
const description = `Supporting ${card.creator.name}: ${card.projects.map((p) => `${p.title} (${percentageLabel(p.percentage)})`).join(', ')}${card.other.count ? `, and ${card.other.count} other projects` : ''}.`;
---
<Layout title={`Supporting ${card.creator.name}`} description={description} image={{ url: imageUrl, alt: description, width: 1200, height: 630 }}>
  <section class="shell share-page">
    <header class="share-heading"><p class="eyebrow">{cfg.demo ? 'Demo public support' : 'Public support'}</p><h1>{card.pickMode ? 'More of what matters.' : 'Good things, backed.'}</h1><p>A little encouragement for <a href="/">{card.creator.name}</a> and the things they’re making.</p></header>
    <img class="share-image" src={imageUrl} alt={description} width="1200" height="630" fetchpriority="high"/>
    <div class="share-detail-heading"><h2>The support breakdown</h2><span>{card.projectCount} {card.projectCount === 1 ? 'project' : 'projects'} supported</span></div>
    <div class="share-projects">{card.projects.map((p) => <article>
      <div class="share-project-heading"><div><p class="eyebrow">{p.category}{p.archived && ' · Archived'}</p><h3>{p.archived ? p.title : <a href={`/support/${p.id}`}>{p.title} ↗</a>}</h3></div><strong>{percentageLabel(p.percentage)}</strong></div>
      <>{!card.pickMode && <div class="share-allocation" aria-hidden="true"><span style={`width:${Math.max(1, p.percentage)}%`}></span></div>}</>
      <p class="share-caption">{card.pickMode ? 'of these picks' : 'of this support'}</p>
      {p.progress ? <div class="share-aspiration"><p>{money(p.target)} aspiration</p><AspirationProgress progress={p.progress}/></div> : <p class="share-caption">{card.pickMode ? p.target > 0 ? `${money(p.target)} aspiration` : 'A suggestion, freely given' : 'Ongoing work · every bit helps'}</p>}
    </article>)}</div>
    {card.other.count > 0 && <p class="share-footnote">Another {percentageLabel(card.other.percentage)} went to {card.other.count} other {card.other.count === 1 ? 'project' : 'projects'}. The six largest available projects appear above.</p>}
    <p class="share-footnote">{card.pickMode ? 'These picks are suggestions. The creator receives the whole gift and chooses how to use it.' : 'Allocation percentages reflect this confirmed public tip. Project progress reflects all current public support. Private support is never included.'}</p>
    <div class="share-invitation"><div><h2>Make a little room for good things.</h2><p>Choose the projects you’d love to see more of.</p></div><a class="button" href="/">Support {card.creator.name} ↗</a></div>
    <div class="share-follow"><FollowButton kind="creator" subject={cfg.ownerDid} title={card.creator.name} returnTo={Astro.url.pathname}/><a href="/discover">Discover more creators ↗</a></div>
  </section>
</Layout>
<style>
  .share-page { max-width: 980px; padding-top: 36px; }
  .share-heading { max-width: 680px; margin-bottom: 28px; }
  h1 { font-size: 28px; line-height: 1.15; font-weight: 650; letter-spacing: -.04em; margin-block: 12px; }
  .share-heading > p:last-child { color: var(--color-muted); font-size: 16px; line-height: 1.7; }
  .share-heading a { color: var(--color-primary); }
  .share-image { display: block; width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--color-border); }
  .share-detail-heading { display: flex; gap: 12px; justify-content: space-between; flex-wrap: wrap; align-items: center; margin: 32px 0 16px; }
  h2 { font-size: 18px; font-weight: 600; letter-spacing: -.02em; }
  .share-detail-heading > span, .share-caption, .share-footnote { color: var(--color-muted); font-size: 12px; }
  .share-projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  article { padding: 24px; border: 1px solid var(--color-border); border-radius: 8px; }
  .share-project-heading { display: flex; gap: 20px; align-items: center; justify-content: space-between; }
  h3 { font-size: 15px; line-height: 1.5; margin-top: 8px; font-weight: 550; overflow-wrap: anywhere; }
  .share-project-heading strong { color: var(--color-primary); font-size: 26px; font-weight: 600; letter-spacing: -.04em; }
  .share-allocation { height: 7px; border-radius: 6px; background: #edf2fa; margin-top: 20px; overflow: hidden; }
  .share-allocation span { display: block; height: 100%; border-radius: inherit; background: var(--color-primary); }
  .share-caption { margin-top: 6px; }
  .share-aspiration { margin-top: 20px; }
  .share-aspiration > p { font-size: 13px; font-weight: 550; }
  .share-footnote { margin-top: 18px; line-height: 1.7; }
  .share-invitation { margin-top: 36px; padding: 24px; border: 1px solid var(--color-border); border-radius: 8px; background: #f7faff; display: flex; gap: 24px; justify-content: space-between; align-items: center; }
  .share-invitation p { font-size: 13px; color: var(--color-muted); margin-top: 6px; }
  .share-invitation .button { text-align: center; }
  .share-follow { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 24px; margin-top: 24px; font-size: 13px; }
  .share-follow > a { min-height: 44px; display: inline-flex; align-items: center; color: var(--color-primary); }
  @media(max-width:600px) { .share-page { padding-top: 32px; } .share-projects { grid-template-columns: 1fr; } .share-invitation { align-items: stretch; flex-direction: column; } article { padding: 20px; } }
</style>
