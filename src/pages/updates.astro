---
import Layout from '../layouts/Layout.astro';
import Creator from '../components/Creator.astro';
import PostCard from '../components/PostCard.astro';
import { projectLog } from '../lib/project-log';
const page = Math.max(0, Math.min(1000, Number.parseInt(Astro.url.searchParams.get('logPage') || '0') || 0));
const log = await projectLog(undefined, Astro.url.searchParams.get('cursor')?.slice(0, 2048), page);
const older = new URLSearchParams({ ...(log.cursor ? { cursor: log.cursor } : {}), logPage: String(page + 1) });
---
<Layout title="Field notes"><Creator/><section class="shell py-10"><div class="max-w-2xl"><span class="eyebrow">A little closer to the process</span><h2 class="display text-4xl mt-3 mb-4">Notes along the way.</h2><p class="muted text-sm mb-8">Posts from the creator’s Bluesky account. Photos, little milestones, and conversations worth keeping.</p>{log.unavailable && <p class="notice">Some Bluesky posts are unavailable. Please try again.</p>}{log.posts.map((post) => <PostCard post={post}/>)}{!log.posts.length && !log.unavailable && <p class="panel muted">The first field note is still growing.</p>}{(log.cursor || log.moreLinked) && <a class="button secondary" href={`/updates?${older}`}>Older posts →</a>}</div></section></Layout>
