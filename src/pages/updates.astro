---
import Layout from '../layouts/Layout.astro';
import Creator from '../components/Creator.astro';
import PostCard from '../components/PostCard.astro';
import { projectLog } from '../lib/project-log';
const page = Math.max(0, Math.min(1000, Number.parseInt(Astro.url.searchParams.get('logPage') || '0') || 0));
const log = await projectLog(undefined, Astro.url.searchParams.get('cursor')?.slice(0, 2048), page);
const older = new URLSearchParams({ ...(log.cursor ? { cursor: log.cursor } : {}), logPage: String(page + 1) });
---
<Layout title="Updates"><Creator/><section class="shell page-section"><div class="max-w-2xl"><h2 class="section-title mb-3">Latest updates</h2><p class="muted text-sm mb-6">Posts from the creator’s Bluesky account. Photos, little milestones, and conversations worth keeping.</p>{log.unavailable && <p class="notice">Some Bluesky posts are unavailable. Please try again.</p>}{log.posts.length > 0 && <div class="post-feed">{log.posts.map((post) => <PostCard post={post}/>)}</div>}{!log.posts.length && !log.unavailable && <p class="panel muted">The first field note is still growing.</p>}{(log.cursor || log.moreLinked) && <a class="button secondary" href={`/updates?${older}`}>Older posts →</a>}</div></section></Layout>
