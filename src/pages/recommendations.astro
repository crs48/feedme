---
import Layout from '../layouts/Layout.astro';
import { recommendations } from '../lib/recommendations';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?returnTo=/recommendations');
let records: Awaited<ReturnType<typeof recommendations>> = [];
let unavailable = false;
try { records = [...new Map((await recommendations(user.did)).map((r) => [r.value.did, r])).values()]; } catch { unavailable = true; }
---
<Layout title="Your recommendations" noindex><section class="shell page-section"><h1 class="display page-title mb-3">Your recommendations</h1><p class="muted text-sm mb-7">Public endorsements from your AT Protocol account. You can remove one even if its creator’s site is offline.</p><a class="button secondary mb-7" href="/discover">Discover more creators ↗</a>{unavailable && <p class="notice error">Your recommendations could not be loaded. Reconnect your account or retry.</p>}{!unavailable && !records.length && <p class="panel muted">A circle starts with one good recommendation.</p>}<div class="grid md:grid-cols-2 gap-5">{records.map(({ value }) => <article class="panel"><h2 class="section-title mb-3">{value.name}</h2><p class="text-sm muted mb-5">{value.description}</p><div class="flex flex-wrap gap-4"><a href={value.url} rel="noopener noreferrer" class="button secondary">Visit their site ↗</a><a href={`/recommend?did=${encodeURIComponent(value.did)}`} class="button secondary">Edit</a><form method="post" action="/api/social"><input type="hidden" name="action" value="recommend"/><input type="hidden" name="subject" value={value.did}/><input type="hidden" name="remove" value="yes"/><input type="hidden" name="consent" value="public"/><input type="hidden" name="returnTo" value="/recommendations"/><button class="button secondary">Remove</button></form></div></article>)}</div></section></Layout>
