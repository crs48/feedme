---
import { creatorCircle } from '../lib/creator-circle';
import Layout from '../layouts/Layout.astro';
import Creator from '../components/Creator.astro';
import Icon from '../components/Icon.astro';
import Avatar from '../components/Avatar.astro';
import { demoPerson } from '../lib/demo-media';
import FollowButton from '../components/FollowButton.astro';

import { config } from '../lib/config';
---
<Layout title="Good company"><Creator/><section class="shell py-10"><span class="eyebrow">Generosity has a way of growing</span><h2 class="display text-4xl mt-3 mb-4">Good people. Good possibilities.</h2><p class="muted text-sm max-w-xl mb-8">People and projects I believe in. Follow a thread, find something that moves you, and send a little encouragement their way.</p><a href="/discover" class="button secondary mb-7">Find your Bluesky circle ↗</a><div class="grid md:grid-cols-2 gap-6">{creatorCircle().map((f) => <article class="panel"><div class="mb-5"><Avatar name={f.name} src={config().demo ? demoPerson(f.did)?.avatar : undefined} size={64}/></div><h3 class="section-title mb-3">{f.name}</h3><p class="muted text-sm mb-6">{f.description}</p><a href={f.url} rel="noopener noreferrer" class="button secondary">Visit their corner <Icon name="arrow" size={15}/></a>{f.did && <div class="mt-4"><FollowButton kind="creator" subject={f.did} title={f.name}/></div>}{config().demo && <p class="text-xs muted mt-3">An illustrative recommendation · example link</p>}</article>)}</div>{!creatorCircle().length && <p class="panel muted">A circle starts with one good recommendation. More soon.</p>}</section></Layout>
