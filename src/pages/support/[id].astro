---
import { randomUUID } from 'node:crypto';
import Layout from '../../layouts/Layout.astro';
import Artwork from '../../components/Artwork.astro';
import Markdown from '../../components/Markdown.astro';
import PostCard from '../../components/PostCard.astro';
import SupportTimeline from '../../components/SupportTimeline.astro';
import { projectLog } from '../../lib/project-log';
import Icon from '../../components/Icon.astro';
import FollowButton from '../../components/FollowButton.astro';
import Avatar from '../../components/Avatar.astro';
import { demoCover, demoImageSources, demoPerson } from '../../lib/demo-media';
import { projectUri } from '../../lib/social-model';
import { profile, project, totals, updates } from '../../lib/repository';
import { money } from '../../lib/model';
import { config } from '../../lib/config';
import { cookieOptions, digest, randomToken } from '../../lib/auth';
import { getDb, setKv } from '../../lib/db';
const p = project(Astro.params.id || '');
if (!p || p.status === 'archived') return Astro.redirect('/404');
const creator = profile();
const t = totals(p.id);
const user = Astro.locals.user;
const cfg = config();
const cover = p.image ? { url: p.image, alt: p.title } : cfg.demo ? demoCover(p.id) : undefined;
const requestId = randomUUID();
const binding = Astro.cookies.get('feedme_checkout')?.value || randomToken();
Astro.cookies.set('feedme_checkout', binding, { ...cookieOptions(), maxAge: 86400 });
setKv(getDb(), 'checkout-form', requestId, { projectId: p.id, binding: digest(binding) }, 3600_000);
const legacyNotes = cfg.demo ? [] : updates().filter((u) => u.projectId === p.id && !u.postUri);
const linkedPage = Math.max(0, Math.min(1000, Number.parseInt(Astro.url.searchParams.get('logPage') || '0') || 0));
const log = await projectLog(p.id, Astro.url.searchParams.get('cursor')?.slice(0, 2048), linkedPage);
const olderLog = new URLSearchParams({ ...(log.cursor ? { cursor: log.cursor } : {}), logPage: String(linkedPage + 1) });
---
<Layout title={p.title} description={p.summary}>
  <div class="shell"><a href="/" class="back-link">← {creator.name}’s projects</a></div>
  <div class="shell support-layout">
    <header class="project-header">
      <div class:list={['detail-art', { placeholder: !cover }]}>{cover ? <img src={cover.url} srcset={demoImageSources(cover.url)} sizes="(max-width: 700px) calc(100vw - 40px), 584px" alt={cover.alt} width="960" height="640" decoding="async" referrerpolicy="no-referrer"/> : <Artwork color={p.color} title={p.title}/>}</div>
      <div class="project-meta"><span class="tag">{p.category}</span><span>{p.status === 'complete' ? 'Complete' : p.kind === 'ongoing' ? 'Ongoing' : 'In progress'}</span></div>
      <h1 class="display">{p.title}</h1><p class="project-summary">{p.summary}</p>
      <nav class="project-tabs" aria-label="Project sections"><a href="#support">Support</a><a href="#story">Story</a><a href="#project-log">Updates</a><a href="#supporters">Supporters</a></nav>
    </header>
    <aside>
      <section id="support" class="panel support-panel" aria-labelledby="support-heading">
        <h2 id="support-heading" class="section-title">Support this project</h2><div class="support-recipient"><Avatar name={creator.name} src={cfg.demo ? demoPerson(cfg.ownerDid)?.avatar : undefined} size={28}/><p>A one-time tip for {creator.name}.</p></div>
        <div class="funding-summary"><div class="funding-total"><span><strong>{money(t.amount)}</strong> <span class="muted">public support</span></span><span class="muted">{t.count} tips</span></div>{p.target > 0 && <><div class="progress" role="meter" aria-label="Public support toward aspiration" aria-valuemin={0} aria-valuemax={p.target} aria-valuenow={Math.min(t.amount, p.target)}><span style={`width:${Math.min(100, t.amount / p.target * 100)}%`}></span></div><p class="muted">{money(p.target)} aspiration. Every tip is kept, regardless of progress.</p></>}</div>
        {p.status === 'active' ? <form action="/api/checkout" method="post">
          <input type="hidden" name="projectId" value={p.id}/><input type="hidden" name="requestId" value={requestId}/>
          <label class="field amount-field">Amount<span class="amount-input"><span aria-hidden="true">$</span><input name="amount" inputmode="decimal" type="number" min="1" max="1000" step="0.01" value="15" required aria-describedby="amount-currency"/><span id="amount-currency">USD</span></span></label>
          <fieldset class="privacy-options"><legend>Support visibility</legend>
            <label><input type="radio" name="visibility" value="anonymous" checked/><span><strong>Anonymous</strong><small>No AT Protocol identity attached.</small></span></label>
            <label><input type="radio" name="visibility" value="private" disabled={!user}/><span><strong>Private</strong><small>Your DID is shared only with the creator.</small></span></label>
            <label><input type="radio" name="visibility" value="public" disabled={!user}/><span><strong>Public</strong><small>Your DID, project, amount, and date become public.</small></span></label>
          </fieldset>
          <label class="anonymous-consent"><input type="checkbox" name="announceAnonymously" value="yes"/><span>Show “Anonymous” with this project and date on the public timeline. Keep my amount hidden.</span></label>
          {!user && <p class="sign-in-hint"><a href={`/login?returnTo=/support/${p.id}`}>Sign in with AT Protocol</a> to choose a named tip.</p>}
          <details class="note-option"><summary>Add a private note <span class="muted">(optional)</span></summary><label class="field mt-3">Your note<textarea name="note" maxlength="500" rows="3" placeholder="A few words of encouragement…"></textarea><span class="muted note-help">Only the creator sees this. Up to 500 characters.</span></label></details>
          <button class="button full checkout-button" type="submit">{cfg.demo ? 'Try a demo tip' : 'Continue to Stripe'}<Icon name="arrow" size={16}/></button>
          <p class="checkout-caption"><Icon name="lock" size={12}/>{cfg.demo ? 'Demo only. No card details or charges.' : 'Secure checkout, powered by Stripe.'}</p>
          <p class="privacy-disclosure">Anonymous means no social identity in Feedme. Stripe and the recipient may still see billing information. Public records can be copied across the open network.</p>
        </form> : <div class="notice">This project is complete. Thank you for your support.</div>}
      </section>
      <section class="follow-panel"><h2>Keep up with this project</h2><p>Follow updates, with or without a tip. You can share a public message after supporting.</p><FollowButton kind="project" subject={projectUri(cfg.ownerDid, p.id)} title={p.title}/></section>
    </aside>
    <div class="project-community">
      <section id="story" aria-label="Project story"><Markdown content={p.description}/>{p.link && <a class="button secondary mt-6" href={p.link} rel="noopener noreferrer">Explore the project ↗</a>}</section>
      <section id="project-log" class="mt-10"><h2 class="section-title mb-3">Project updates</h2><p class="muted text-sm mb-6">Public posts from {creator.name}. Join the conversation on Bluesky.</p>{log.unavailable && <p class="notice" role="status">Some Bluesky posts could not be loaded. Try refreshing in a moment.</p>}{log.posts.length > 0 && <div class="post-feed">{log.posts.map((post) => <PostCard post={post}/>)}</div>}{!log.posts.length && !log.unavailable && <p class="panel muted text-sm">No project posts yet. Follow along for the next update.</p>}{(log.cursor || log.moreLinked) && <a class="button secondary" href={`${Astro.url.pathname}?${olderLog}#project-log`}>Older project posts →</a>}{legacyNotes.length > 0 && <details class="mt-6"><summary class="text-sm muted">Earlier notes</summary><div class="mt-5">{legacyNotes.map((n) => <article class="panel mb-4"><time class="eyebrow" datetime={n.createdAt}>{new Date(n.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })}</time><p class="prose-copy text-sm mt-3">{n.text}</p></article>)}</div></details>}</section>
      <SupportTimeline projectId={p.id}/>
    </div>
  </div>
</Layout>
<style>
  .back-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 16px; font-size: 13px; color: var(--color-muted); }
  .support-layout { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(0,1fr); column-gap: 64px; row-gap: 32px; margin-top: 16px; }
  .project-header { grid-column: 1; grid-row: 1; min-width: 0; }
  .support-layout > aside { grid-column: 2; grid-row: 1 / span 2; min-width: 0; }
  .project-community { grid-column: 1; grid-row: 2; min-width: 0; }
  .detail-art { overflow: hidden; border-radius: 10px; border: 1px solid var(--color-border); aspect-ratio: 2.5; }
  .detail-art img { width: 100%; height: 100%; object-fit: cover; }
  .project-meta { display: flex; align-items: center; gap: 12px; margin-top: 24px; font-size: 12px; color: var(--color-muted); }
  .project-header h1 { font-size: 32px; line-height: 1.2; margin-top: 14px; }
  .project-summary { color: var(--color-muted); margin-top: 14px; font-size: 15px; line-height: 1.7; }
  .project-tabs { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 20px; border-bottom: 1px solid var(--color-border); }
  .project-tabs a { display: inline-flex; align-items: center; min-height: 48px; font-size: 13px; color: #0866ff; font-weight: 500; }
  .project-tabs a:hover { text-decoration: underline; }
  .support-panel { padding: 28px; box-shadow: 0 4px 24px #1a1f3608, 0 1px 3px #1a1f3606; }
  .support-panel h2 { font-size: 20px; }
  .support-recipient { display:flex; align-items:center; gap:8px; margin-top:12px; font-size:13px; color:var(--color-muted); }
  .funding-summary { font-size: 12px; padding-bottom: 20px; border-bottom: 1px solid var(--color-border); margin-block: 24px; }
  .funding-total { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
  .funding-total strong { font-size: 14px; font-weight: 600; }
  .funding-summary p { margin-top: 8px; }
  .amount-input { display: flex; align-items: center; gap: 10px; padding-inline: 14px; border: 1px solid #c0c8d2; border-radius: 6px; box-shadow: 0 1px 2px #1a1f3608; }
  .amount-input:focus-within { border-color: var(--color-primary); outline: 3px solid #0866ff26; }
  .amount-input input { border: 0; border-radius: 0; padding: 10px 0; box-shadow: none; font-size: 24px; font-weight: 500; min-height: 52px; outline: none; }
  .amount-input > span:first-child { font-size: 22px; color: var(--color-muted); }
  #amount-currency { font-size: 13px; color: var(--color-muted); }
  .privacy-options { border: 0; margin: 0 0 16px; padding: 0; }
  .privacy-options legend { font-size: 14px; font-weight: 500; margin-bottom: 8px; }
  .privacy-options label { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border: 1px solid #c0c8d2; border-radius: 6px; margin-top: 8px; cursor: pointer; }
  .privacy-options label:first-of-type { margin-top: 0; }
  .privacy-options input { margin-top: 3px; }
  .privacy-options strong { display: block; font-size: 14px; font-weight: 500; }
  .privacy-options small { display: block; color: var(--color-muted); font-size: 12px; line-height: 1.5; margin-top: 2px; }
  .privacy-options label:has(input:checked) { border-color: var(--color-primary); background: #f2f7ff; box-shadow: 0 0 0 1px var(--color-primary); }
  .privacy-options label:has(input:disabled) { background: var(--color-surface); border-color: var(--color-border); cursor: not-allowed; }
  .anonymous-consent { display: flex; align-items: flex-start; gap: 10px; padding-block: 4px; font-size: 12px; color: var(--color-muted); margin-bottom: 12px; cursor: pointer; }
  .anonymous-consent input { margin-top: 3px; }
  form:has(input[name='visibility']:checked:not([value='anonymous'])) .anonymous-consent { display: none; }
  .sign-in-hint { font-size: 12px; color: var(--color-muted); margin-bottom: 12px; }
  .sign-in-hint a { color: #0866ff; text-decoration: underline; }
  .note-option { margin-bottom: 16px; }
  .note-option summary { font-size: 13px; padding-block: 12px; }
  .note-help { font-size: 12px; font-weight: 400; }
  .checkout-button { min-height: 48px; }
  .checkout-caption { display: flex; justify-content: center; align-items: center; gap: 6px; color: var(--color-muted); font-size: 12px; margin-top: 12px; text-align: center; }
  .privacy-disclosure { color: var(--color-muted); font-size: 12px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--color-border); line-height: 1.6; }
  .follow-panel { padding: 24px 4px 0; }
  .follow-panel h2 { font-size: 16px; font-weight: 600; letter-spacing: -.02em; }
  .follow-panel > p { font-size: 13px; color: var(--color-muted); margin-block: 8px 16px; }
  @media(max-width:1000px) { .support-layout { column-gap: 32px; } .support-panel { padding: 24px; } }
  @media(max-width:800px) { .support-layout { grid-template-columns: 1fr; row-gap: 28px; margin-top: 12px; max-width: 600px; } .support-layout > aside { grid-column: 1; grid-row: 2; } .project-community { grid-row: 3; } .detail-art { max-height: 200px; } .detail-art.placeholder { display: none; } .detail-art.placeholder + .project-meta { margin-top: 0; } .project-header h1 { font-size: 28px; } .project-meta { margin-top: 20px; } .project-tabs { gap: 0 22px; margin-top: 12px; } .support-panel { padding: 20px; } .back-link { margin-top: 8px; } }
  @media(max-width:359px) { .support-panel { padding: 16px; } .project-tabs { justify-content: space-between; gap: 0 8px; } }
</style>
