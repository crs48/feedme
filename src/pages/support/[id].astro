---
import { randomUUID } from 'node:crypto';
import Layout from '../../layouts/Layout.astro';
import Artwork from '../../components/Artwork.astro';
import Icon from '../../components/Icon.astro';
import FollowButton from '../../components/FollowButton.astro';
import { projectUri } from '../../lib/social-model';
import { profile, project, totals, updates } from '../../lib/repository';
import { money } from '../../lib/model';
import { config } from '../../lib/config';
import { cookieOptions, digest, randomToken } from '../../lib/auth';
import { getDb, setKv } from '../../lib/db';
const p = project(Astro.params.id || '');
if (!p || p.status === 'archived') return Astro.redirect('/404');
const creator = profile();
const t = totals(p.id);
const user = Astro.locals.user;
const cfg = config();
const requestId = randomUUID();
const binding = Astro.cookies.get('feedme_checkout')?.value || randomToken();
Astro.cookies.set('feedme_checkout', binding, { ...cookieOptions(), maxAge: 86400 });
setKv(getDb(), 'checkout-form', requestId, { projectId: p.id, binding: digest(binding) }, 3600_000);
const notes = updates().filter((u) => u.projectId === p.id);
---
<Layout title={p.title} description={p.summary}>
  <div class="shell pt-8"><a href="/" class="text-xs muted">← Back to {creator.name}’s projects</a></div>
  <div class="shell support-layout">
    <article><div class="detail-art">{p.image ? <img src={p.image} alt={p.title} width="640" height="380" referrerpolicy="no-referrer"/> : <Artwork color={p.color} title={p.title}/>}</div><div class="flex items-center gap-3 mt-7"><span class="tag">{p.category}</span><span class="text-xs muted">{p.kind === 'ongoing' ? 'An ongoing practice' : 'A work in progress'}</span></div><h1 class="serif text-4xl md:text-5xl leading-tight mt-4 mb-6">{p.title}</h1><p class="prose-copy">{p.description}</p>{p.link && <a class="button secondary mt-6" href={p.link} rel="noopener noreferrer">Explore the project ↗</a>}
      {notes.length > 0 && <div class="mt-10"><h2 class="section-title mb-6">Notes along the way</h2>{notes.map((n) => <div class="panel mb-4"><time class="eyebrow" datetime={n.createdAt}>{new Date(n.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })}</time><p class="prose-copy text-sm mt-3">{n.text}</p></div>)}</div>}
    </article>
    <aside><div class="panel support-panel"><span class="eyebrow">A little fuel for the journey</span><h2 class="section-title mt-2 mb-2">Make this possible.</h2><p class="muted text-xs mb-6">A tip for {creator.name}. A nudge toward more of this.</p>
      <div class="flex justify-between text-xs mb-2"><span><strong>{money(t.amount)}</strong> <span class="muted">public support</span></span><span class="muted">{t.count} tips</span></div>{p.target > 0 && <><div class="progress"><span style={`width:${Math.min(100, t.amount / p.target * 100)}%`}></span></div><p class="muted text-[10px] mt-2 mb-6">{money(p.target)} aspiration. Tips are kept regardless of progress.</p></>}
      {p.status === 'active' ? <form action="/api/checkout" method="post">
        <input type="hidden" name="projectId" value={p.id}/><input type="hidden" name="requestId" value={requestId}/>
        <label class="field mt-6">Your one-time support (USD)<input name="amount" inputmode="decimal" type="number" min="1" max="1000" step="0.01" value="15" required aria-describedby="amount-help"/></label><p id="amount-help" class="muted text-[11px] -mt-3 mb-6">A little or a lot — it all makes room.</p>
        <fieldset class="privacy-options"><legend class="text-xs font-semibold mb-2">How would you like to show up?</legend>
          <label><input type="radio" name="visibility" value="anonymous" checked/><span><strong>Quietly, with love</strong><small>No AT Protocol identity attached.</small></span></label>
          <label><input type="radio" name="visibility" value="private" disabled={!user}/><span><strong>Just between us</strong><small>Your DID is shared with the creator.</small></span></label>
          <label><input type="radio" name="visibility" value="public" disabled={!user}/><span><strong>Cheering from the rooftops</strong><small>Your DID, project, amount, and date become public.</small></span></label>
        </fieldset>
        {!user && <p class="text-xs muted mb-5"><a class="underline" href={`/login?returnTo=/support/${p.id}`}>Sign in with your AT Protocol account</a> to choose a named tip.</p>}
        <label class="field">A little note <span class="muted font-normal">Optional · only the creator sees this</span><textarea name="note" maxlength="500" rows="3" placeholder="A few words of encouragement…"></textarea></label>
        <button class="button full" type="submit"><Icon name="heart" size={16}/>{cfg.demo ? 'Try a demo tip' : 'Continue to Stripe'}</button>
        <p class="text-[10px] muted text-center mt-3">{cfg.demo ? 'A pretend tip. No card details, no charge.' : 'Secure, hosted checkout. Available payment methods appear on Stripe.'}</p>
        <p class="text-[10px] muted mt-5">Anonymous here means no social identity in Feedme. Stripe and the recipient may still see billing information. Public records can be copied across the open network.</p>
      </form> : <div class="notice">This project is complete. Thank you for helping it grow.</div>}
    </div><p class="flex gap-2 items-center justify-center mt-5 text-[11px] muted"><Icon name="lock" size={13}/>Your tip note always stays private.</p><div class="panel mt-6"><p class="eyebrow mb-2">Stay for the story</p><h2 class="section-title mb-3">See what grows from here.</h2><p class="muted text-xs mb-5">Follow this project, with or without a tip. You can write a separate public message after supporting it.</p><FollowButton kind="project" subject={projectUri(cfg.ownerDid, p.id)} title={p.title}/></div></aside>
  </div>
</Layout>
<style>
  .support-layout { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); gap:54px; margin-top:28px; }
  .detail-art { overflow:hidden; border-radius:14px; aspect-ratio:1.68; }
  .detail-art img { width:100%; height:100%; object-fit:cover; }
  .support-panel { position:sticky; top:20px; }
  .privacy-options { border:0; margin:0 0 15px; padding:0; }
  .privacy-options label { display:flex; align-items:flex-start; gap:10px; margin:12px 0; }
  .privacy-options input { margin-top:5px; flex-shrink:0; }
  .privacy-options strong { display:block; font-size:12px; font-weight:500; }
  .privacy-options small { display:block; color:#7a8373; font-size:10px; line-height:1.5; }
  .privacy-options label:has(input:disabled) { opacity:.55; }
  @media(max-width:800px) { .support-layout { grid-template-columns:1fr; gap:32px; } .support-panel { position:static; } }
</style>
