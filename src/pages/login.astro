---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BlueskySignup from '../components/BlueskySignup.astro';
import { config } from '../lib/config';
import { safeReturnPath } from '../lib/http';
import { readPickReview } from '../lib/pick-checkout';
import { support } from '../lib/repository';
import { canAccessTip } from '../lib/tip-sharing';
import { receiptState } from '../lib/receipt';
const cfg = config();
const returnTo = safeReturnPath(Astro.url.searchParams.get('returnTo'));
const reviewToken = returnTo.startsWith('/checkout/review?') ? new URL(returnTo, cfg.origin).searchParams.get('token') : undefined;
let savedGift = false;
if (reviewToken) { try { readPickReview(Astro, reviewToken); savedGift = true; } catch { /* Expired drafts must be reviewed again. */ } }
const receiptReturn = returnTo.startsWith('/thanks?');
const billingReturn = returnTo === '/billing';
const candidate = receiptReturn ? support(new URL(returnTo, cfg.origin).searchParams.get('id') || '') : undefined;
const confirmedReceipt = receiptState(canAccessTip(candidate, Astro.locals.user, Astro.cookies.get('feedme_checkout')?.value) ? candidate : undefined).kind === 'confirmed';
const guestPath = receiptReturn || billingReturn || returnTo.startsWith('/support/') ? returnTo : '/';
---
<Layout title="Sign in with Bluesky" noindex>
  <section class="shell page-section"><div class="login-flow panel">
    <h1 class="display page-title mb-4">Sign in with Bluesky</h1>
    <p class="muted text-sm mb-5">{receiptReturn ? confirmedReceipt ? 'Your tip is complete. Connect your account to stay in touch.' : 'Connect your account, then return to your receipt for payment status.' : billingReturn ? 'Use the profile you attached to your support. Anonymous tips can be managed with your checkout email.' : 'Use your profile here without creating a separate Feedme account.'}</p>
    {savedGift && <p class="notice">Your gift is saved in this browser for up to one hour from review. You’ll review it again after signing in. <a class="login-link" href={returnTo}>Back to review or change visibility</a></p>}
    {reviewToken && !savedGift && <p class="notice">Your saved review is no longer available here. Return to the creator’s page to review your gift again.</p>}
    <form action="/auth/login" method="post" id="handle-signin">
      <input type="hidden" name="returnTo" value={returnTo}/>
      <label class="field">Your Bluesky handle<input name="handle" placeholder="yourname.bsky.social" autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="253" aria-describedby="handle-help"/><span class="handle-help" id="handle-help">Use your full handle, like @yourname.bsky.social or your own domain.</span></label>
      <button class="button full">Continue with Bluesky <Icon name="arrow" size={15}/></button>
    </form>
    <p class="text-xs muted mt-4">Your account provider will ask you to sign in and review access. Your password stays with that provider.</p>
    <p class="text-xs muted mt-3">Signing in doesn’t post, follow anyone, or change a previous tip’s privacy.</p>
    <details class="login-detail"><summary>Use another AT Protocol account</summary><p class="muted text-sm">Enter its full handle or DID in the same field above. You don’t need to create a Bluesky account. Available social features depend on your provider.</p></details>
    {!billingReturn && <details class="login-detail"><summary>New to Bluesky?</summary><BlueskySignup returnTo={returnTo}/></details>}
    <div class="guest-choice">
      {savedGift ? <form method="post" action="/api/checkout/review"><input type="hidden" name="editReview" value={reviewToken}/><input type="hidden" name="intent" value="anonymous"/><button class="login-link">Continue without a profile</button><p class="text-xs muted mt-2">Keeps your amount, picks, schedule, and note. Turns off public sharing. Review again before paying.</p></form> : <a class="login-link" href={guestPath}>{receiptReturn ? 'Back to your receipt' : billingReturn ? 'Manage billing without Bluesky' : 'Continue without an account'}</a>}
      {!receiptReturn && !billingReturn && <p class="text-xs muted mt-2">No account needed to tip. Stripe and the creator may still receive billing details.</p>}
    </div>
    <p class="text-xs muted mt-4"><a class="login-link" href="/bluesky" target="_blank" rel="noopener noreferrer">Why Bluesky? ↗</a></p>
    {cfg.demo && <section class="demo-login"><h2 class="section-title mb-3">Try a fictional account</h2><p class="text-xs muted mb-4">This demo doesn’t sign in to Bluesky or charge money. Your real account stays unchanged.</p><form method="post" action="/auth/demo" class="mb-3"><input type="hidden" name="role" value="supporter"/><input type="hidden" name="returnTo" value={returnTo}/><button class="button full">Explore as a supporter</button></form><form method="post" action="/auth/demo"><button class="button secondary full">Explore the demo studio</button></form></section>}
  </div></section>
</Layout>
<style>
  .login-flow { max-width:480px; margin-inline:auto; }
  .handle-help { color:var(--color-muted); font-size:12px; line-height:1.6; font-weight:400; }
  .login-detail { margin-top:14px; border-top:1px solid var(--color-border); }
  .login-detail summary { display:list-item; cursor:pointer; min-height:44px; padding-block:12px; font-size:13px; font-weight:500; }
  .guest-choice,.demo-login { margin-top:24px; border-top:1px solid var(--color-border); padding-top:20px; }
  .login-link { display:inline-flex; align-items:center; min-height:44px; font-size:13px; color:var(--color-primary); text-decoration:underline; text-underline-offset:3px; cursor:pointer; }
</style>
