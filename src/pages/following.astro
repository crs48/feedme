---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { config } from '../lib/config';
import { followingFeed } from '../lib/following';
import { readFollows } from '../lib/social-repo';
import { parseProjectUri } from '../lib/social-model';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?returnTo=/following');
const projectsOnly = Astro.url.searchParams.get('view') !== 'people';
const page = Math.max(0, Math.min(1250, Number.parseInt(Astro.url.searchParams.get('page') || '0') || 0));
const cursor = Astro.url.searchParams.get('cursor')?.slice(0, 2048);
let subscriptions: Awaited<ReturnType<typeof readFollows>> = [];
let result: Awaited<ReturnType<typeof followingFeed>> = { posts: [], warnings: [], cursor: undefined };
let unavailable = false;
try {
  subscriptions = await readFollows(user.did, projectsOnly ? 'project' : 'creator');
  result = await followingFeed(user.did, subscriptions.slice(page * 8, page * 8 + 8), projectsOnly, cursor);
} catch { unavailable = true; }
const visible = subscriptions.slice(page * 8, page * 8 + 8);
const path = (params: Record<string, string>) => `/following?${new URLSearchParams({ view: projectsOnly ? 'projects' : 'people', page: String(page), ...params })}`;
---
<Layout title="Following the good things" noindex>
  <section class="shell py-10"><p class="eyebrow">A little closer to the work</p><div class="following-heading"><div><h1 class="display text-4xl md:text-5xl mt-3 mb-4">Good things, in motion.</h1><p class="muted text-sm max-w-xl">The people you believe in. The projects you’re curious about. A place to keep up with what’s growing.</p></div><span class="avatar w-16 h-16"><Icon name="leaf" size={28}/></span></div>
    <nav class="flex tabs mt-8 mb-8" aria-label="Following feeds"><a class="tab" href="/following" aria-current={projectsOnly ? 'page' : undefined}>Project updates</a><a class="tab" href="/following?view=people" aria-current={!projectsOnly ? 'page' : undefined}>People on Bluesky</a></nav>
    {config().demo && <p class="notice mb-6">You’re exploring demo follows and posts. Nothing here changes a real Bluesky account.</p>}
    {unavailable && <p class="notice error" role="status">Your social provider could not load this feed. Refresh or <a class="underline" href="/login?returnTo=/following">reconnect your account</a>. Your follows have not changed.</p>}
    {result.warnings.map((warning) => <p class="notice" role="status">{warning}</p>)}
    <div class="following-layout"><div>
      {!unavailable && !result.posts.length && <div class="panel py-10"><span class="eyebrow">There’s room for something good</span><h2 class="section-title mt-3 mb-3">{subscriptions.length ? 'A quiet moment in the garden.' : 'Follow a little curiosity.'}</h2><p class="muted text-sm mb-6">{subscriptions.length ? projectsOnly ? 'No matching project posts in this batch. Updates appear when creators share tagged field notes to Bluesky.' : 'No recent posts to show. Check back when your people have something new to share.' : 'Follow a creator or keep up with a project. Supporting it financially is always optional.'}</p><a class="button secondary" href="/">Find a project ↗</a></div>}
      {result.posts.map((post) => <PostCard post={post} projectTitle={post.projectTitle}/>)}
      {result.cursor && <a class="button secondary" href={path({ cursor: result.cursor })}>Older posts →</a>}
      {projectsOnly && subscriptions.length > 0 && <p class="text-xs muted mt-5">Recent public posts from up to eight followed projects per page. Project follows bring updates here; they do not enable Bluesky push notifications.</p>}
    </div><aside><div class="panel"><p class="eyebrow mb-3">{projectsOnly ? 'Your project garden' : 'Your social circle'}</p><h2 class="section-title mb-5">{subscriptions.length} {projectsOnly ? (subscriptions.length === 1 ? 'project' : 'projects') : (subscriptions.length === 1 ? 'person' : 'people')} followed</h2>{visible.map((follow) => { const target = parseProjectUri(follow.value.subject); return <div class="subscription"><a class="text-xs font-medium break-words" href={target?.did === config().ownerDid ? `/support/${target.id}` : `https://bsky.app/profile/${encodeURIComponent(target?.did || follow.value.subject)}`} rel="noopener noreferrer">{follow.value.title || (target ? target.id : follow.value.subject)}</a><form method="post" action="/api/social" class="mt-2"><input type="hidden" name="action" value="follow"/><input type="hidden" name="kind" value={projectsOnly ? 'project' : 'creator'}/><input type="hidden" name="subject" value={follow.value.subject}/><input type="hidden" name="enabled" value="no"/><input type="hidden" name="returnTo" value="/following"/><button class="text-xs underline muted">Unfollow</button></form></div>; })}
      {(page > 0 || subscriptions.length > (page + 1) * 8) && <nav class="flex gap-4 mt-5 text-xs" aria-label="Followed pages">{page > 0 && <a class="underline" href={path({ page: String(page - 1) })}>← Previous</a>}{subscriptions.length > (page + 1) * 8 && <a class="underline" href={path({ page: String(page + 1) })}>Next →</a>}</nav>}
      <a class="button secondary mt-6" href="/circle">Meet the circle ↗</a></div><p class="text-xs muted mt-4">Your follows live with your AT Protocol account. They’re public, and you can unfollow whenever you like.</p></aside></div>
  </section>
</Layout>
<style>
  .following-heading { display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .following-layout { display:grid; grid-template-columns:minmax(0,1.8fr) minmax(0,1fr); gap:30px; }
  .subscription { border-bottom:1px solid #e3e8ee; padding:14px 0; }
  .subscription a, .subscription button { display:inline-flex; align-items:center; min-height:44px; }
  .subscription button { padding-inline:8px; }
  @media(max-width:700px) { .following-layout { grid-template-columns:1fr; } .following-heading > .avatar { display:none; } }
</style>
