---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { profile } from '../../lib/repository';
import { config } from '../../lib/config';
import { getDb, getKv, pendingWrites } from '../../lib/db';
import { privateSpace } from '../../lib/habitat';
import { connectedAccount } from '../../lib/payments';
import { adminEvents } from '../../lib/admin';
import { unresolvedAdmins } from '../../lib/admin-identity';
import { resolvedDid } from '../../lib/identity-settings';
import { displayDate } from '../../lib/analytics';
const cfg = config();
const p = profile();
const queue = pendingWrites(getDb());
const events = adminEvents().slice(0,25);
const ownerSession = Boolean(getKv(getDb(), 'oauth-session', cfg.ownerDid));
---
<AdminLayout title="Settings" description="Your public profile, connections, and administrative access.">
  <div class="admin-settings-grid"><div><section class="admin-card"><h2>Public profile</h2><p class="admin-help mt-3">Import your name, handle, avatar, and bio from Bluesky. You can customize them below.</p><form method="post" action="/api/studio" class="mb-6"><input type="hidden" name="action" value="profile-import"/><input type="hidden" name="returnTo" value="/studio/settings"/><button class="button secondary">Import Bluesky profile</button></form><form method="post" action="/api/studio"><input type="hidden" name="action" value="profile"/><input type="hidden" name="returnTo" value="/studio/settings"/><label class="field">Name<input name="name" value={p.name} maxlength="80" required/></label><label class="field">Display handle<input name="handle" value={p.handle} maxlength="253"/></label><label class="field">Bio<textarea name="bio" minlength="3" maxlength="500" required>{p.bio}</textarea></label><label class="field">Location<input name="location" value={p.location} maxlength="80"/></label><label class="field">Website<input name="website" type="url" value={p.website}/></label><label class="field">Avatar URL<input name="avatar" type="url" value={p.avatar} placeholder="https://…"/></label><label class="flex gap-3 items-start my-5 text-sm"><input type="checkbox" name="discoverable" value="yes" checked={p.discoverable !== false}/><span>List my profile in Feedme discovery. Your Feedme address and public profile are published to your PDS; private tips stay private.</span></label><button class="button">Save profile</button></form><p class="admin-help mt-4">Display settings do not change who can sign in as an administrator.</p></section>
  <section class="admin-card"><h2>Recommend a friend</h2><a class="button secondary mt-4" href="/discover">Find people you know ↗</a><p class="admin-help mt-3">Add someone to your public circle and help supporters discover their work.</p><form method="post" action="/api/studio"><input type="hidden" name="action" value="friend"/><input type="hidden" name="returnTo" value="/studio/settings"/><label class="field">Name<input name="name" maxlength="80" required/></label><label class="field">Support page<input name="url" type="url" required placeholder="https://…"/></label><label class="field">DID (optional)<input name="did" placeholder="did:plc:…"/></label><label class="field">Why you love their work<textarea name="description" minlength="3" maxlength="180" required></textarea></label><button class="button secondary">Add to circle</button></form></section></div>
  <div><section class="admin-card"><h2>Connections</h2><dl class="mt-3"><div class="admin-stat-line"><dt>Creator OAuth grant</dt><dd>{cfg.demo ? 'Demo identity' : ownerSession ? 'Stored' : 'Sign in as creator'}</dd></div><div class="admin-stat-line"><dt>Habitat private space</dt><dd>{privateSpace() ? 'Created' : 'Not connected'}</dd></div></dl><form method="post" action="/api/studio" class="mt-4"><input type="hidden" name="action" value="space"/><input type="hidden" name="returnTo" value="/studio/settings"/><button class="button secondary full" disabled={cfg.demo || Boolean(privateSpace())}>Create private storage</button></form><dl class="mt-4"><div class="admin-stat-line"><dt>Stripe account</dt><dd>{connectedAccount() ? 'Linked' : 'Not connected'}</dd></div><div class="admin-stat-line"><dt>Stripe API key</dt><dd>{cfg.stripeKey ? 'Configured' : 'Not configured'}</dd></div><div class="admin-stat-line"><dt>Stripe webhook secret</dt><dd>{cfg.stripeWebhookSecret ? 'Configured' : 'Not configured'}</dd></div></dl><form method="post" action="/api/studio" class="mt-4"><input type="hidden" name="action" value="stripe"/><input type="hidden" name="returnTo" value="/studio/settings"/><button class="button secondary full" disabled={cfg.demo}>{connectedAccount() ? 'Continue Stripe onboarding' : 'Connect Stripe'}</button></form><p class="admin-help mt-4">A linked account may still need onboarding. Stripe verifies payment readiness at checkout. Banking, refunds, payouts, and subscription cancellation are managed in Stripe.</p></section>
  <section class="admin-card"><h2>Data sync</h2><p class="admin-help mt-3">Public records use <a class="underline" href="/protocol">fund.feedme · Protocol schemas</a>. Your Feedme address is included when you save your profile or publish a project.</p><p class="admin-help mt-3">{queue.length}{queue.length === 50 ? '+' : ''} records awaiting sync to Habitat or the public PDS. Draft projects and the admin activity log stay local.</p>{queue.some((q) => q.attempts > 0) && <p class="admin-warning mt-3">Some records failed to sync. Sign in again as the creator if its grant has expired, then retry.</p>}<form method="post" action="/api/studio"><input type="hidden" name="action" value="sync"/><input type="hidden" name="returnTo" value="/studio/settings"/><button class="button secondary">Sync records</button></form><p class="admin-help mt-4">All admins publish through the creator’s stored OAuth grant. The creator must sign in at least once before public or private writes can sync.</p></section>
  <section class="admin-card"><h2>Administrators</h2><p class="admin-help mt-3">All administrators can edit projects, publish as the creator, and view private financial records and supporter notes.</p>{cfg.identities.accounts.map((account, i) => <div class="py-4 border-b border-slate-200"><h3 class="break-all">{account.startsWith('did:') ? account : `@${account}`} <span class="status-pill">{i === 0 ? 'Creator' : 'Admin'}</span></h3><p class="admin-code mt-2">{cfg.demo ? 'Demo mode uses a fictional creator DID.' : resolvedDid(cfg.dataDir, account) || 'Unresolved · access not granted'}</p></div>)}{unresolvedAdmins().length > 0 && <p class="admin-warning mt-4">Some configured accounts could not be verified. Check the handles and Habitat connectivity.</p>}<p class="admin-help mt-4">Set <code>BLUESKY_HANDLE</code> for the creator (default <code>crs.land</code>). Add comma-separated handles or DIDs in <code>ADMIN_ACCOUNTS</code>, then restart. Handles are pinned to permanent DIDs on first verification. Removing an account from configuration revokes its admin access after restart.</p><p class="admin-help mt-3">Signed in as <span class="admin-code">{Astro.locals.user?.did}</span></p></section></div></div>
  <section class="admin-card"><h2 class="mb-5">Recent admin activity</h2><p class="admin-help mb-5">Local change history. No private notes, payment details, or secrets are recorded here.</p>{events.length ? <div class="admin-table-scroll"><table class="admin-table"><thead><tr><th>Date · UTC</th><th>Action</th><th>Target</th><th>Administrator DID</th></tr></thead><tbody>{events.map((e) => <tr><td>{displayDate(e.createdAt)}<span class="admin-caption">{e.createdAt.slice(11,19)}</span></td><td>{e.action}</td><td class="break-all">{e.target}</td><td class="admin-code">{e.actor}</td></tr>)}</tbody></table></div> : <p class="admin-empty">Changes you make in the dashboard will appear here.</p>}</section>
</AdminLayout>
