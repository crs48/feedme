---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminFilters from '../../components/AdminFilters.astro';
import Avatar from '../../components/Avatar.astro';
import { adminReport, selectedPayments, supporterPerformance, summarizePayments, reportPage, displayDate } from '../../lib/analytics';
import { payments, projects } from '../../lib/repository';
import { people } from '../../lib/people';
import { money } from '../../lib/model';
const list = projects(true);
const { query, error } = adminReport(Astro.url.searchParams);
const records = selectedPayments(payments(), query);
const supporters = supporterPerformance(records);
const pagination = reportPage(supporters, Astro.url.searchParams);
const profiles = await people(pagination.items.map((p) => p.did));
const anonymous = summarizePayments(records.filter((s) => s.visibility === 'anonymous' || !s.supporterDid));
---
<AdminLayout title="Supporters" description="The people making your work possible, with privacy choices respected.">
  {error && <p class="notice error">{error}</p>}<AdminFilters query={query} projects={list}/>
  <section class="admin-card"><div class="admin-card-heading"><h2>{supporters.length} named supporters</h2><span class="admin-help">Ranked by net support in this period</span></div>{pagination.items.length ? <div class="admin-table-scroll"><table class="admin-table"><thead><tr><th>Supporter</th><th>Projects supported</th><th>First / latest in period</th><th class="numeric">Net support</th></tr></thead><tbody>{pagination.items.map((s) => { const p = profiles.get(s.did); return <tr><td><div class="admin-person"><Avatar name={p?.name || s.did} src={p?.avatar} size={36}/><div><a class="admin-link break-all" href={`https://bsky.app/profile/${s.did}`} rel="noopener noreferrer">{p?.name || s.did}</a>{p?.handle && <span class="admin-caption">@{p.handle}</span>}</div></div><a class="admin-link mt-2" href={`/studio/payments?range=${query.range}&from=${query.from}&to=${query.to}&project=${encodeURIComponent(query.project)}&q=${encodeURIComponent(s.did)}`}>View payments →</a></td><td>{s.projects.map((id) => <span class="admin-caption">{list.find((p) => p.id === id)?.title || id}</span>)}</td><td>{displayDate(s.first)}<span class="admin-caption">Latest {displayDate(s.last)}</span></td><td class="numeric"><strong>{money(s.net)}</strong><span class="admin-caption">{s.count} payments</span></td></tr>; })}</tbody></table></div> : <p class="admin-empty">No named supporters in this period yet. Named public and private tips appear here once confirmed.</p>}<nav class="admin-pagination" aria-label="Supporter pages"><span>{pagination.page > 1 && <a class="admin-link" href={pagination.previous}>← Previous</a>}</span><span>Page {pagination.page} of {pagination.pages}</span><span>{pagination.page < pagination.pages && <a class="admin-link" href={pagination.next}>Next →</a>}</span></nav></section>
  <section class="admin-card"><div class="admin-person"><Avatar name="Anonymous" size={36}/><div><h2>Anonymous & guest support</h2><p class="admin-help">{anonymous.anonymousPayments} tips · {money(anonymous.net)} net support</p></div></div><p class="admin-help mt-4">These tips are counted as payments, not unique people. No attempt is made to connect anonymous payments to an AT Protocol identity. Private named supporters are visible here only to administrators.</p></section>
</AdminLayout>
