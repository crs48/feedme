---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import BrandIcon from '../components/BrandIcon.astro';
import BrandMeta from '../components/BrandMeta.astro';
import PoweredBy from '../components/PoweredBy.astro';
import { siteName } from '../lib/site-branding';
import { config } from '../lib/config';
import { isAdmin } from '../lib/auth';
interface Props { title?: string; description?: string; noindex?: boolean; image?: { url: string; alt: string; width: number; height: number }; }
const { title = 'Good things grow with a little support', description = 'A home for the things you make and the people who make them possible.', noindex = false } = Astro.props;
const cfg = config();
const name = siteName(cfg);
const user = Astro.locals.user;
const canonical = new URL(Astro.url.pathname, cfg.origin).href;
const notice = Astro.url.searchParams.get('notice');
const error = Astro.url.searchParams.get('error');
const socialImage = Astro.props.image || { url: `${cfg.origin}/social-card.png`, alt: 'Feedme: independent work, supported. A white bowl of hearts and creative possibilities on a coral and lavender background.', width: 1200, height: 630 };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{cfg.sandbox ? 'Sandbox · ' : ''}{title} · {name}</title><meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/><BrandMeta name={name} manifest={cfg.demo && !cfg.siteName ? '/site.webmanifest' : '/app.webmanifest'}/>
    <meta property="og:type" content="website"/><meta property="og:title" content={`${title} · ${name}`}/>
    <meta property="og:site_name" content={name}/>
    <meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
    <meta property="og:image" content={socialImage.url}/><meta name="theme-color" content="#ffffff"/>
    {socialImage && <><meta property="og:image:type" content="image/png"/><meta property="og:image:width" content={String(socialImage.width)}/><meta property="og:image:height" content={String(socialImage.height)}/><meta property="og:image:alt" content={socialImage.alt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content={socialImage.url}/><meta name="twitter:image:alt" content={socialImage.alt}/></>}
    {(cfg.demo || cfg.sandbox || noindex) && <meta name="robots" content="noindex,nofollow"/>}
  </head>
  <body class="feedme-app">
    <a href="#main" class="skip-link">Skip to content</a>
    {cfg.demo && <div class="demo-strip"><span class="demo-label">Demo</span> {cfg.libcardRemoteDemo ? 'Real LibCard profile. Simulated tips. No real payments.' : 'Explore Feedme. No real payments.'}</div>}
    {cfg.sandbox && <div class="demo-strip"><span class="demo-label">Sandbox</span> Test payments only. No real money moves. Bluesky publishing is disabled.</div>}
    <header class="site-header"><div class="shell header-inner">
      <a href="/" class="brand" aria-label={`${name} home`}><BrandIcon size={26}/><span>{name === 'Feedme' ? 'feedme' : name}</span></a>
      <nav aria-label="Main navigation" class="main-nav">
        <a href="/updates" class="nav-link nav-section" aria-current={Astro.url.pathname === '/updates' ? 'page' : undefined}>Updates</a>
        <a href="/circle" class="nav-link nav-section" aria-current={Astro.url.pathname === '/circle' ? 'page' : undefined}>Circle</a>
        <details class="nav-menu"><summary>More <span aria-hidden="true">⌄</span></summary><div class="nav-menu-panel">
          <a href="/">Projects</a><a class="mobile-nav-section" href="/updates">Updates</a><a class="mobile-nav-section" href="/circle">Circle</a>
          <a href="/discover">Discover creators</a>{user && <a href="/following">Following</a>}<a href="/about">About Feedme</a>
          <a href="/billing">Manage support</a>{user && <form action="/auth/logout" method="post"><button>Sign out</button></form>}
        </div></details>
        {isAdmin(user) ? <a class="button secondary" href="/studio">Dashboard</a> : user ? <a class="button secondary" href="/following">Following</a> : <a class="button secondary" href="/login">Sign in <Icon name="arrow" size={14}/></a>}
      </nav>
    </div></header>
    <main id="main">
      {(notice || error) && <div class="shell"><div class:list={['notice', { error: Boolean(error) }]} role="status">{(error || notice)?.slice(0, 500)}</div></div>}
      <slot/>
    </main>
    <footer class="shell site-footer">
      <a href="/">{name} · Independent work, supported.</a>
      <div class="footer-links"><a href="/billing">Manage support</a><a href="/privacy">Privacy</a><a href="/about">Open source <span aria-hidden="true">↗</span></a>{user?.did !== cfg.ownerDid && <a href={`/recommend?did=${encodeURIComponent(cfg.ownerDid)}`}>Recommend this creator</a>}</div>
      <PoweredBy/>
    </footer>
  </body>
</html>
<style>
  .demo-strip { background: var(--color-surface); border-bottom: 1px solid var(--color-border); text-align: center; padding: 8px 12px; font-size: 12px; color: var(--color-muted); }
  .demo-label { display: inline-block; margin-right: 8px; border: 1px solid #d8dce5; padding: 0 5px; border-radius: 4px; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
  .site-header { border-bottom:1px solid var(--color-border); background:white; }
  .header-inner { min-height:60px; display:flex; align-items:center; justify-content:space-between; gap:16px; }
  .brand { display:flex; align-items:center; gap:10px; min-height:44px; min-width:0; font-weight:600; font-size:16px; letter-spacing:-.01em; }
  .brand span { overflow-wrap:anywhere; }
  .main-nav { display:flex; align-items:center; gap:24px; font-size:14px; font-weight:500; color:var(--color-muted); }
  .nav-link { display:inline-flex; align-items:center; min-height:44px; }
  .main-nav a:hover, .nav-link[aria-current] { color:var(--color-primary); }
  .main-nav .button { min-height:36px; padding:6px 12px; }
  .nav-menu { position:relative; }
  .nav-menu summary { display:flex; align-items:center; gap:5px; list-style:none; }
  .nav-menu summary::-webkit-details-marker { display:none; }
  .nav-menu-panel { position:absolute; right:0; top:100%; width:210px; z-index:40; background:white; border:1px solid var(--color-border); border-radius:8px; padding:6px; box-shadow:0 8px 24px #1a1f3614; }
  .nav-menu-panel a, .nav-menu-panel button { display:flex; align-items:center; width:100%; min-height:44px; padding:8px 12px; border-radius:6px; text-align:left; }
  .nav-menu-panel a:hover,.nav-menu-panel button:hover { background:var(--color-surface); }
  .nav-menu-panel .mobile-nav-section { display:none; }
  .site-footer { padding-block:24px; margin-top:48px; border-top:1px solid var(--color-border); font-size:12px; color:var(--color-muted); display:flex; flex-wrap:wrap; align-items:center; gap:8px 24px; }
  .footer-links { display:flex; flex-wrap:wrap; gap:0 18px; }
  .site-footer a { display: inline-flex; align-items: center; min-height: 44px; }
  .skip-link { position: absolute; left: -9999px; top: 8px; z-index: 30; padding: 12px; background: white; }
  .skip-link:focus { left: 12px; }
  @media(max-width:600px) { .main-nav { gap:12px; font-size:13px; } .main-nav .nav-section { display:none; } .nav-menu-panel .mobile-nav-section { display:flex; } .main-nav .button { min-height:44px; font-size:13px; } .site-footer { margin-top:32px; gap:4px 16px; } .site-footer :global(.powered-by) { margin-left:0; } }
</style>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.nav-menu').forEach(menu => {
    document.addEventListener('pointerdown', event => { if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
    menu.addEventListener('keydown', event => { if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); } });
  });
</script>
