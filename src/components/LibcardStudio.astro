---
import { config } from '../lib/config';
import { loadLibcardSnapshot, type RefreshStatus } from '../lib/libcard';
import { getDb, getKv } from '../lib/db';
import { sourceKey } from '../lib/libcard-schema';
import { projects } from '../lib/repository';
import { money } from '../lib/model';
import { sampleLibcardGoal } from '../lib/libcard-catalog';
const cfg = config();
const snapshot = await loadLibcardSnapshot();
const status = cfg.libcard ? getKv<RefreshStatus>(getDb(), 'libcard-refresh', sourceKey(cfg.libcard)) : undefined;
const managed = projects(true).filter(p => p.libcard);
const skipped = snapshot?.document.items.filter(item => item.feedme?.skip) || [];
// A skip no longer carries the old target ID. Match archived records by their
// source destination, keeping active duplicates and other repositories separate.
const editable = managed.filter(p => p.libcard!.present || !snapshot || sourceKey(p.libcard!.source) !== sourceKey(snapshot.source)
  || !skipped.some(item => item.kind === p.libcard!.kind && item.url === p.libcard!.url));
---
{cfg.libcard && <section class="admin-card mb-6" id="libcard">
  <div class="admin-card-heading"><div><p class="eyebrow mb-2">From LibCard</p><h2>{cfg.libcard.repo}</h2></div><form method="post" action="/api/studio"><input type="hidden" name="action" value="libcard-refresh"/><input type="hidden" name="returnTo" value="/studio/projects"/><button class="button secondary">Refresh LibCard</button></form></div>
  <p class="admin-help">{cfg.demo && !cfg.libcardRemoteDemo ? 'Offline fixture · no GitHub requests' : `GitHub · ref: ${cfg.libcard.ref}`} · {managed.filter(p => p.status === 'active').length} live · {managed.filter(p => p.status === 'archived').length} archived</p>
  <p class="admin-help">{cfg.libcardDefaultSupport === 'explicit' ? 'Only links with a feedme.id in LibCard accept picks.' : 'Links and socials accept picks by default, up to 99 plus you. Hide any target below to exclude it.'} Items with feedme: &#123; skip: true &#125; stay off Feedme in either mode.</p>
  <details class="admin-more"><summary>Import details</summary><p class="admin-help">Last fetch attempt: {status?.attemptedAt || snapshot?.checkedAt || 'Not yet'}<br/>Last good check: {snapshot?.checkedAt || 'Not yet'}</p>
  {snapshot && <p class="admin-help break-all">Content SHA-256: {snapshot.hash}{snapshot.etag && <><br/>ETag: {snapshot.etag}</>}</p>}</details>
  {status?.error && <p class="admin-warning">{status.error}</p>}
  <p class="admin-help mt-4">Labels, links, and descriptions come from your repository. Local changes below never write back to LibCard. Hiding a target stops new picks; existing recurring gifts keep their original allocation until canceled.</p>
  {cfg.libcardRemoteDemo && <p class="notice">Demo preview: source links and socials that are not skipped can receive simulated picks. Goals without a source value use stable sample amounts, and displayed progress is illustrative. Set an aspiration below to preview your own goal; 0 hides it. No sample support is added to the payment ledger.</p>}
  <div class="libcard-admin-list">{editable.map(p => <details class="libcard-admin-item"><summary><span class="libcard-admin-title">{p.title}<small>{p.libcard!.kind}</small></span><span class="libcard-admin-state"><span class="status-pill" data-status={p.status}>{p.libcard!.hidden ? 'Hidden' : !p.libcard!.present ? 'Removed' : p.status === 'active' ? 'Live' : 'Archived'}</span><span class="libcard-admin-aspiration">{p.target > 0 ? money(p.target) : 'No aspiration'}</span><span aria-hidden="true" class="libcard-admin-chevron">⌄</span></span></summary>
    <div class="libcard-admin-row"><div><p class="admin-help">{p.summary}</p><p class="admin-help break-all">{p.id}{p.libcard!.url && <> · <a href={p.libcard!.url} target="_blank" rel="noopener noreferrer">{p.libcard!.url} ↗</a></>}</p><p class="admin-help">Source aspiration: {p.libcard!.sourceAspiration ? money(p.libcard!.sourceAspiration) : 'None'}</p></div>
    <form method="post" action="/api/studio"><input type="hidden" name="action" value="libcard-override"/><input type="hidden" name="id" value={p.id}/><input type="hidden" name="returnTo" value="/studio/projects"/>
      {p.id !== 'creator' && <label class="admin-help"><input type="checkbox" name="hidden" value="yes" checked={p.libcard!.hidden}/> Hide on Feedme</label>}
      <label class="field mt-3">Aspiration override (USD)<input type="number" name="aspiration" min="0" max="1000000" step="1" value={p.libcard!.aspirationOverride === undefined ? '' : p.libcard!.aspirationOverride / 100} placeholder="Use source value"/><span class="admin-help">Blank inherits; 0 removes the aspiration.{cfg.libcardRemoteDemo && sampleLibcardGoal(p) && ` Preview goal: ${money(sampleLibcardGoal(p)!.goal)}.`}</span></label><button class="button secondary">Save local settings</button>
    </form>
    </div></details>)}
  {skipped.map(item => <article class="libcard-admin-skipped"><div><h3>{item.label}</h3><p class="admin-help">{item.kind} · Managed in libcard.config.yaml</p></div><span class="status-pill">Skipped in LibCard</span></article>)}
  </div>
  {skipped.length > 0 && <p class="admin-help mt-3">Skipped items are read-only here. Edit their feedme settings in LibCard to allow picks again; local hiding settings still apply. Existing recurring gifts keep their original picks until canceled.</p>}
</section>}
<style>
  .libcard-admin-list { margin-top:20px; border-top:1px solid var(--color-border); }
  .libcard-admin-item,.libcard-admin-skipped { border-bottom:1px solid var(--color-border); }
  .libcard-admin-item > summary,.libcard-admin-skipped { display:flex; justify-content:space-between; align-items:center; gap:16px; padding:14px 0; min-height:64px; }
  .libcard-admin-item > summary { list-style:none; cursor:pointer; border-radius:4px; }
  .libcard-admin-item > summary::-webkit-details-marker { display:none; }
  .libcard-admin-title { font-size:13px; font-weight:500; }
  .libcard-admin-title small { display:block; color:var(--color-muted); font-size:11px; font-weight:400; margin-top:2px; }
  .libcard-admin-state { display:flex; align-items:center; gap:12px; flex-shrink:0; }
  .libcard-admin-aspiration { color:var(--color-muted); font-size:12px; min-width:90px; text-align:right; font-variant-numeric:tabular-nums; }
  .libcard-admin-chevron { color:var(--color-caption); }
  .libcard-admin-item[open] .libcard-admin-chevron { transform:rotate(180deg); }
  .libcard-admin-item > summary:hover .libcard-admin-title { color:var(--color-primary); }
  .libcard-admin-item > summary:focus-visible { outline:2px solid var(--color-primary); outline-offset:3px; }
  .libcard-admin-row { display:grid; grid-template-columns:minmax(0,1fr) 270px; gap:24px; padding:16px; background:var(--color-surface); border-radius:6px; margin-bottom:16px; }
  .libcard-admin-row .admin-help + .admin-help { margin-top:8px; }
  .libcard-admin-skipped h3 { font-size:13px; }
  @media(max-width:750px) { .libcard-admin-row { grid-template-columns:1fr; gap:12px; } .libcard-admin-aspiration { display:none; } .libcard-admin-state { gap:8px; } }
</style>
