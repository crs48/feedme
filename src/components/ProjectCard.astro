---
import type { Project } from '../lib/model';
import { money } from '../lib/model';
import { totals } from '../lib/repository';
import Artwork from './Artwork.astro';
import Icon from './Icon.astro';
import { config } from '../lib/config';
import { demoCover, demoImageSources } from '../lib/demo-media';
interface Props { project: Project; }
const { project: p } = Astro.props;
const total = totals(p.id);
const cover = p.image || (config().demo ? demoCover(p.id)?.url : undefined);
---
<article class="project-card">
  <a href={`/support/${p.id}`} class="project-art" tabindex="-1" aria-hidden="true">{cover ? <img src={cover} srcset={demoImageSources(cover)} sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 950px) 44vw, 347px" alt="" loading="lazy" decoding="async" width="960" height="640" referrerpolicy="no-referrer"/> : <Artwork color={p.color} title={p.title}/>}</a>
  <div class="card-body">
    <div class="card-meta"><span class="tag">{p.category}</span><span>{p.status === 'complete' ? 'Complete' : p.kind === 'ongoing' ? 'Ongoing' : 'In progress'}</span></div>
    <h3><a href={`/support/${p.id}`}>{p.title}</a></h3><p class="summary">{p.summary}</p>
    <div class="card-bottom">
      <div class="support-total"><span><strong>{money(total.amount)}</strong> <span class="muted">public support</span></span><span class="muted">{total.count} {total.count === 1 ? 'tip' : 'tips'}</span></div>
      {p.target > 0 && <><div class="progress" role="meter" aria-label="Public support toward aspiration" aria-valuemin={0} aria-valuemax={p.target} aria-valuenow={Math.min(total.amount, p.target)}><span style={`width:${Math.min(100, total.amount / p.target * 100)}%`}></span></div><p class="target-label">{money(p.target)} aspiration</p></>}
      <a class="support-link" href={`/support/${p.id}`}>{p.status === 'active' ? 'Support project' : 'View project'}<Icon name="arrow" size={16}/></a>
    </div>
  </div>
</article>
<style>
  .project-card { border: 1px solid var(--color-border); border-radius: 14px; overflow: hidden; background: white; display: flex; flex-direction: column; }
  .project-art { display: block; aspect-ratio: 2.65; overflow: hidden; border-bottom: 1px solid var(--color-border); }
  .project-art:has(img) { aspect-ratio: 2; }
  .project-art img { width: 100%; height: 100%; object-fit: cover; }
  .card-body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
  .card-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 16px; font-size: 12px; color: var(--color-muted); }
  h3 { font-size: 19px; font-weight: 600; letter-spacing: -.025em; line-height: 1.35; margin-bottom: 10px; }
  h3 a { display: inline-block; padding-block: 4px; }
  .summary { font-size: 14px; line-height: 1.65; color: var(--color-muted); margin-bottom: 24px; }
  .card-bottom { margin-top: auto; }
  .support-total { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font-size: 12px; margin-bottom: 10px; font-variant-numeric: tabular-nums; }
  .support-total strong { font-size: 14px; font-weight: 600; }
  .target-label { font-size: 12px; color: var(--color-muted); margin-top: 7px; }
  .support-link { display: flex; min-height: 44px; justify-content: space-between; align-items: center; color: #0866ff; font-size: 14px; font-weight: 600; padding-top: 12px; margin-top: 16px; border-top: 1px solid var(--color-border); }
  .support-link:hover { color: #0055cc; }
</style>
