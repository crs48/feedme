---
import type { PostView } from '../lib/bsky-content';
import PostVideo from './PostVideo.astro';
import Avatar from './Avatar.astro';
import { demoImageSources } from '../lib/demo-media';
interface Props { post: PostView; projectTitle?: string; }
const { post, projectTitle } = Astro.props;
---
<article class="panel mb-5">
  <header class="post-author"><Avatar name={post.author} src={post.avatar}/><div class="min-w-0"><strong>{post.author}</strong><div class="post-meta"><time datetime={post.createdAt}>{new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>{post.demo && <span>· Demo post</span>}</div></div>{projectTitle && <span class="tag project-tag">{projectTitle}</span>}</header>
  <div class:list={{ 'sensitive-post': post.sensitive }}>
    {post.sensitive && <p class="text-xs muted mb-3">This post has a content warning. Open it on Bluesky to view it with your moderation settings.</p>}
    {!post.sensitive && <><p class="prose-copy text-sm">{post.segments.map((segment) => segment.href ? <a href={segment.href} class="underline" rel="noopener noreferrer ugc">{segment.text}</a> : segment.text)}</p>
      {post.images.length > 0 && <div class:list={['post-images mt-5', { multiple: post.images.length > 1 }]}>{post.images.map((image) => <a href={image.url} rel="noopener noreferrer"><img src={image.url} srcset={demoImageSources(image.url)} sizes="(max-width: 700px) calc(100vw - 82px), 620px" width={demoImageSources(image.url) ? 960 : undefined} height={demoImageSources(image.url) ? 640 : undefined} alt={image.alt} loading="lazy" decoding="async" referrerpolicy="no-referrer"/></a>)}</div>}
      {post.video && <div class="mt-5"><PostVideo {...post.video}/></div>}
      {post.external && <a class="link-card mt-5" href={post.external.url} rel="noopener noreferrer ugc">{post.external.image && <img src={post.external.image} alt="" loading="lazy" referrerpolicy="no-referrer"/>}<div><strong class="text-sm">{post.external.title || new URL(post.external.url).hostname}</strong><p class="text-xs muted mt-1">{post.external.description}</p><span class="text-xs muted block mt-2">{new URL(post.external.url).hostname} ↗</span></div></a>}
    </>}
  </div>
  <a class="text-xs underline muted inline-block mt-5" href={post.url} rel="noopener noreferrer">{post.demo ? 'Explore the project' : 'Reply, like, or repost on Bluesky'} ↗</a>
</article>
<style>
  .post-author { display:flex; align-items:center; gap:12px; margin-bottom:18px; }
  .post-author strong { display:block; font-size:14px; font-weight:600; overflow-wrap:anywhere; }
  .post-meta { display:flex; flex-wrap:wrap; gap:4px; margin-top:2px; font-size:12px; color:var(--color-muted); }
  .project-tag { margin-left:auto; max-width:40%; }
  .post-images { display:grid; gap:8px; } .post-images.multiple { grid-template-columns:1fr 1fr; }
  .post-images img { width:100%; max-height:500px; object-fit:cover; border-radius:9px; }
  .link-card { display:block; overflow:hidden; border:1px solid #e3e8ee; border-radius:10px; }
  .link-card img { width:100%; max-height:250px; object-fit:cover; } .link-card > div { padding:16px; }
  @media(max-width:480px) { .post-author { flex-wrap:wrap; } .project-tag { max-width:100%; margin-left:52px; } }
</style>
