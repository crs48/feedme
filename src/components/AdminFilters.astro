---
import type { ReportQuery } from '../lib/analytics';
import type { Project } from '../lib/model';
interface Props { query: ReportQuery; projects: Project[]; detailed?: boolean; }
const { query: q, projects, detailed = false } = Astro.props;
const ranges = [['30d','Last 30 days'],['week','This week'],['month','This month'],['90d','Last 90 days'],['year','This year'],['all','All time'],['custom','Custom dates']];
---
<form method="get" class="admin-filters">
  <div class="admin-filter-row"><label class="field">Period<select name="range">{ranges.map(([value,label]) => <option value={value} selected={q.range === value}>{label}</option>)}</select></label><label class="field">Project<select name="project"><option value="">All projects</option>{projects.map((p) => <option value={p.id} selected={q.project === p.id}>{p.title}</option>)}</select></label><label class="field">Group earnings<select name="interval"><option value="week" selected={q.interval === 'week'}>By week</option><option value="month" selected={q.interval === 'month'}>By month</option></select></label><button class="button secondary">Apply filters</button></div>
  <details open={q.range === 'custom' || Boolean(q.q || q.status || q.frequency || q.visibility)}><summary>{detailed ? 'Search, payment filters & custom dates' : 'Custom date range'}</summary><div class="admin-filter-row"><label class="field">From (select Custom dates above)<input type="date" name="from" value={q.from} min="2000-01-01" max={new Date().toISOString().slice(0,10)}/></label><label class="field">Through · UTC<input type="date" name="to" value={q.to} min="2000-01-01" max={new Date().toISOString().slice(0,10)}/></label>{detailed && <><label class="field">Payment ID or supporter DID<input type="search" name="q" value={q.q} placeholder="Search payments" maxlength="100"/></label><label class="field">Status<select name="status"><option value="">Any status</option>{['paid','pending','failed','refunded','disputed'].map((s) => <option selected={q.status === s}>{s}</option>)}</select></label><label class="field">Frequency<select name="frequency"><option value="">Any frequency</option>{[['once','One time'],['monthly','Monthly'],['yearly','Yearly']].map(([value,label]) => <option value={value} selected={q.frequency === value}>{label}</option>)}</select></label><label class="field">Visibility<select name="visibility"><option value="">Any visibility</option>{['public','private','anonymous'].map((s) => <option selected={q.visibility === s}>{s}</option>)}</select></label></>}</div></details>
</form>
