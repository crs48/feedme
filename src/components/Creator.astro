---
import Icon from './Icon.astro';
import FollowButton from './FollowButton.astro';
import Avatar from './Avatar.astro';
import { demoPerson } from '../lib/demo-media';
import { profile } from '../lib/repository';
import { config } from '../lib/config';
const p = profile();
const current = Astro.url.pathname;
---
<section class="creator shell">
  <div class="creator-info">
    <div class="creator-avatar"><Avatar name={p.name} src={config().demo ? demoPerson(config().ownerDid)?.avatar : undefined} size={64}/></div>
    <div class="min-w-0"><h1 class="display creator-name">{p.name}</h1><div class="handle">{p.handle ? `@${p.handle}` : 'Independent creator'}</div></div>
  </div>
  <div class="creator-bio"><p>{p.bio}</p><div class="creator-meta">{p.location && <span><Icon name="location" size={14}/>{p.location}</span>}{p.website && <a href={p.website} rel="noopener noreferrer">Website ↗</a>}</div></div>
  <div class="creator-follow"><FollowButton kind="creator" subject={config().ownerDid} title={p.name}/></div>
</section>
<nav class="shell tabs" aria-label="Creator sections">
  <a class="tab" aria-current={current === '/' ? 'page' : undefined} href="/">Projects</a>
  <a class="tab" aria-current={current === '/updates' ? 'page' : undefined} href="/updates">Updates</a>
  <a class="tab" aria-current={current === '/circle' ? 'page' : undefined} href="/circle">Circle</a>
  <span class="protocol"><Icon name="globe" size={13}/>Connected through AT Protocol</span>
</nav>
<style>
  .creator { display: grid; grid-template-columns: minmax(0,1fr) auto; column-gap: 48px; padding-top: 40px; padding-bottom: 28px; }
  .creator-info { display: flex; align-items: center; gap: 16px; }
  .creator-avatar { width: 64px; height: 64px; flex-shrink: 0; }
  .creator-name { font-size: 30px; line-height: 1.2; }
  .handle { color: var(--color-muted); font-size: 14px; margin-top: 5px; overflow-wrap: anywhere; }
  .creator-bio { grid-column: 1; font-size: 15px; color: var(--color-muted); line-height: 1.7; max-width: 600px; margin-top: 20px; }
  .creator-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0 20px; margin-top: 8px; font-size: 13px; }
  .creator-meta > * { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; }
  .creator-meta a { min-height: 44px; }
  .creator-follow { grid-column: 2; grid-row: 1 / span 2; align-self: center; max-width: 230px; }
  .creator-follow:empty { display: none; }
  .tabs { display: flex; border-bottom: 1px solid var(--color-border); }
  .protocol { display: flex; align-items: center; gap: 6px; margin-left: auto; font-size: 12px; color: var(--color-muted); }
  @media(max-width:700px) { .creator { grid-template-columns: 1fr; padding-top: 28px; padding-bottom: 20px; } .creator-name { font-size: 26px; } .creator-bio { margin-top: 16px; } .creator-follow { grid-column: 1; grid-row: 3; max-width: 100%; margin-top: 16px; } .protocol { display: none; } .tab { flex: 1; justify-content: center; margin-right: 0; } }
</style>
