---
import { libcardProfile } from '../lib/libcard';
import FollowButton from './FollowButton.astro';
import Avatar from './Avatar.astro';
import { demoPerson } from '../lib/demo-media';
import { isAdmin } from '../lib/auth';
import { profile } from '../lib/repository';
import { config } from '../lib/config';
import { cachedCreatorBluesky, refreshCreatorBluesky } from '../lib/creator-bluesky';
import { profileText } from '../lib/profile-text';
await refreshCreatorBluesky();
const p = libcardProfile(profile());
const blueskyActor = cachedCreatorBluesky()?.did || (!config().demo && config().ownerDid) || p.handle;
const blueskyUrl = blueskyActor ? `https://bsky.app/profile/${encodeURIComponent(blueskyActor)}` : undefined;
const bio = profileText(p.bio);
---
<section class="creator shell">
  <div class="creator-main">
    <Avatar name={p.name} src={config().demo && !config().libcardRemoteDemo ? demoPerson(config().ownerDid)?.avatar : p.avatar} size={56}/>
    <div class="creator-copy">
      <h1 class="display creator-name">{p.name}</h1>
      <div class="creator-meta">{p.handle && blueskyUrl && <a href={blueskyUrl} rel="noopener noreferrer" aria-label={`@${p.handle} on Bluesky`}>@{p.handle}</a>}{p.location && <><span aria-hidden="true">·</span><span>{p.location}</span></>}{p.website && <a href={p.website} rel="noopener noreferrer">Website ↗</a>}</div>
      {p.bio && <p class="creator-bio">{bio.map(segment => segment.href ? <a href={segment.href} rel="noopener noreferrer ugc">{segment.text}</a> : segment.text)}</p>}
    </div>
  </div>
  <div class="creator-follow">{isAdmin(Astro.locals.user) ? <a href="/studio/settings" class="button secondary">Edit profile</a> : <FollowButton kind="creator" subject={config().ownerDid} title={p.name} compact/>}</div>
</section>
<style>
  .creator { display:flex; flex-wrap:wrap; align-items:flex-start; gap:20px 40px; padding-block:36px 28px; border-bottom:1px solid var(--color-border); }
  .creator-main { flex:1 1 440px; display:flex; align-items:flex-start; gap:18px; min-width:0; }
  .creator-copy { min-width:0; }
  .creator-name { font-size:24px; line-height:1.2; font-weight:600; letter-spacing:-.02em; }
  .creator-meta { display:flex; flex-wrap:wrap; align-items:center; gap:0 8px; font-size:14px; color:var(--color-muted); margin-top:3px; overflow-wrap:anywhere; }
  .creator-meta a { display:inline-flex; align-items:center; min-height:28px; }
  .creator-bio { font-size:15px; line-height:1.6; max-width:560px; color:var(--color-secondary); margin-top:10px; white-space:pre-line; overflow-wrap:anywhere; }
  .creator-bio a { color:var(--color-primary); } .creator a:hover { text-decoration:underline; }
  .creator-follow { flex:0 0 auto; }
  .creator-follow:empty { display: none; }
  @media(max-width:600px) { .creator { padding-block:24px; gap:16px; } .creator-main { gap:12px; } .creator-name { font-size:22px; } .creator-meta { font-size:13px; } .creator-bio { font-size:14px; } .creator-follow { margin-left:68px; } }
  @media(max-width:600px) {
    .creator { padding-block:20px; gap:12px; }
    .creator-main { display:grid; grid-template-columns:56px minmax(0,1fr); gap:2px 12px; }
    .creator-main > :global(.portrait) { grid-row:1 / 3; }
    .creator-copy { display:contents; }
    .creator-name,.creator-meta { grid-column:2; }
    .creator-bio { grid-column:1 / -1; margin-top:12px; }
    .creator-follow { margin-left:0; }
  }
</style>
