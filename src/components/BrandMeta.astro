---
interface Props { name?: string; manifest?: string; }
const { name = 'Feedme', manifest = '/site.webmanifest' } = Astro.props;
---
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48"/>
<link rel="icon" href="/icons/favicon-16.png" type="image/png" sizes="16x16"/>
<link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32"/>
<link rel="icon" href="/icons/favicon-48.png" type="image/png" sizes="48x48"/>
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180"/>
<link rel="manifest" href={manifest}/>
<meta name="application-name" content={name}/>
<meta name="apple-mobile-web-app-title" content={name}/>
