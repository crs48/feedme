---
import Avatar from './Avatar.astro';
import { people } from '../lib/people';
import { money, netSupport, supportParts, type Project, type Support } from '../lib/model';
import { displayDate, paymentDate } from '../lib/analytics';
interface Props { records: Support[]; projects: Project[]; }
const { records, projects } = Astro.props;
const profiles = await people(records.flatMap((s) => s.visibility !== 'anonymous' && s.supporterDid ? [s.supporterDid] : []));
---
{records.length ? <div class="admin-table-scroll"><table class="admin-table"><thead><tr><th>Supporter / payment</th><th>Project</th><th>Status</th><th class="numeric">Net support</th></tr></thead><tbody>{records.map((s) => {
  const person = s.visibility !== 'anonymous' && s.supporterDid ? profiles.get(s.supporterDid) : undefined;
  const name = s.visibility === 'anonymous' ? 'Anonymous' : person?.name || s.supporterDid || 'Guest';
  const parts = supportParts(s);
  return <tr><td><div class="admin-person"><Avatar name={name} src={person?.avatar} size={32}/><div><span class="break-all">{name}</span><span class="admin-caption">{displayDate(paymentDate(s))} · {s.visibility}</span></div></div><details><summary>Payment details</summary><p>ID: {s.id}</p>{s.visibility !== 'anonymous' && s.supporterDid && <p>DID: {s.supporterDid}</p>}<p>Gross: {money(s.amount)} · Refunded: {money(s.refundedAmount)}<br/>{s.frequency === 'monthly' ? 'Monthly subscription' : s.frequency === 'yearly' ? 'Yearly subscription' : 'One-time tip'}</p>{s.note && <p><strong>Private note</strong><br/>{s.note}</p>}{s.disputed && <p>This payment is disputed and excluded from earnings.</p>}</details></td><td>{parts.map((part) => <div class="mb-1"><a class="admin-link" href={`/studio/projects/${part.projectId}`}>{projects.find((p) => p.id === part.projectId)?.title || part.projectId}</a>{parts.length > 1 && <span class="admin-caption">{money(netSupport(part))} net</span>}</div>)}</td><td><span class="status-pill" data-status={s.status}>{s.status}</span></td><td class="numeric"><strong>{money(netSupport(s))}</strong><span class="admin-caption">{s.frequency === 'monthly' ? 'monthly' : s.frequency === 'yearly' ? 'yearly' : 'one time'}</span></td></tr>;
})}</tbody></table></div> : <p class="admin-empty">No payments match these filters. Confirmed support will appear here after payment verification.</p>}
