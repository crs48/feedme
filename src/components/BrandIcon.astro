---
interface Props { size?: number; }
const { size = 32 } = Astro.props;
---
<img class="feedme-icon" src="/icons/icon-64.png" srcset="/icons/icon-64.png 64w, /icons/icon-192.png 192w, /icons/icon-512.png 512w" sizes={`${size}px`} width={size} height={size} alt="" aria-hidden="true"/>
<style>.feedme-icon { display:inline-block; flex-shrink:0; border-radius:22%; object-fit:cover; vertical-align:middle; }</style>
