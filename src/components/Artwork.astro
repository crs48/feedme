---
interface Props { color: string; title: string; }
const { color, title } = Astro.props;
const kind = color === 'peach' ? 'house' : color === 'blue' ? 'code' : 'book';
const paths = {
  house: 'M7 19V9l5-4 5 4v10H7ZM4 11l8-7 8 7M10 19v-6h4v6M9 2V0m3 2V0m3 2V0',
  code: 'm8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16',
  book: 'M5 3h12a2 2 0 0 1 2 2v16H7a3 3 0 0 1 0-6h12M5 3v15M9 7h6M9 10h4',
};
---
<svg class="project-placeholder" viewBox="0 0 640 240" preserveAspectRatio="xMidYMid slice" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <rect width="640" height="240" fill="#f6f8fa"/>
  <rect x="281" y="81" width="78" height="78" rx="18" fill="white" stroke="#e3e8ee"/>
  <g transform="translate(303 103) scale(1.4)" fill="none" stroke="#635bff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={paths[kind]}/></g>
</svg>
<style>.project-placeholder { display: block; width: 100%; height: 100%; object-fit: cover; }</style>
