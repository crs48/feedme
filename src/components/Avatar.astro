---
import { safeWebUrl } from '../lib/markdown';
interface Props { name: string; src?: string; size?: number; }
const { name, src, size = 40 } = Astro.props;
// Local demo paths are explicit; untrusted protocol avatars must be credential-free HTTPS URLs.
const source = src && (/^\/demo\/avatars\/\d+\.jpg$/.test(src) ? src : safeWebUrl(src));
const initials = name.replace(/^@/, '').trim().split(/\s+/).slice(0, 2).map((part) => Array.from(part)[0] || '').join('').toUpperCase() || '?';
---
<span class="portrait" style={`--portrait-size:${size}px`} aria-hidden="true">
  <span class="initials">{initials}</span>
  {/* A failed decorative background stays transparent, revealing initials without an error handler. */}
  {source && <span class="portrait-image" style={`background-image:url(${JSON.stringify(source)})`}></span>}
</span>
<style>
  .portrait { position:relative; display:inline-grid; place-items:center; vertical-align:middle; width:var(--portrait-size); height:var(--portrait-size); flex-shrink:0; overflow:hidden; border-radius:50%; background:#f0efff; color:#5146e8; box-shadow:inset 0 0 0 1px #1a1f3608; }
  .initials { font-size:calc(var(--portrait-size) * .34); font-weight:600; letter-spacing:-.03em; }
  .portrait-image { position:absolute; inset:0; background-size:cover; background-position:center; }
</style>
