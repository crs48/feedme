---
import BrandIcon from './BrandIcon.astro';
---
<a class="powered-by" href="https://feedme.fund/" data-feedme-attribution>
  <BrandIcon size={18}/><span>Powered by <strong>Feedme</strong></span>
</a>
<style>
  .powered-by { display:inline-flex; align-items:center; gap:7px; min-height:44px; margin-left:auto; color:var(--color-muted); font-size:12px; white-space:nowrap; }
  .powered-by strong { color:var(--color-ink); font-weight:600; }
  .powered-by:hover { color:var(--color-primary); }
</style>
