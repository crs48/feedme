---
import type { LibcardItem } from '../lib/libcard-schema';
import { cachedGithubStars, githubRepo } from '../lib/libcard-github';
import { getDb } from '../lib/db';
import LibcardIcon from './LibcardIcon.astro';
interface Props { item?: LibcardItem; }
const info = Astro.props.item && githubRepo(Astro.props.item);
const cached = info?.showCount ? cachedGithubStars(getDb(), info.repo) : undefined;
const count = cached?.count;
---
{info && <a class="github-stars" href={info.url} rel="noopener noreferrer" aria-label={`${info.repo} on GitHub${count !== undefined ? `, ${count} ${count === 1 ? 'star' : 'stars'}` : ''}`} title={`${info.repo}${cached?.checkedAt ? ` · stars checked ${new Date(cached.checkedAt).toUTCString()}` : ''}`}>
  <LibcardIcon name="github" size={15}/><span>GitHub</span>{info.showCount && <><span aria-hidden="true">☆</span><span>{count === undefined ? '—' : count.toLocaleString('en-US')}</span></>}
</a>}
<style>
  .github-stars { display:inline-flex; align-items:center; gap:6px; min-height:36px; padding:0 10px; border:1px solid var(--color-border); border-radius:7px; color:var(--color-muted); font-size:12px; white-space:nowrap; background:white; }
  .github-stars:hover { border-color:#94a3b8; color:var(--color-ink); }
  .github-stars:focus-visible { outline:3px solid #0866ff70; outline-offset:3px; }
</style>
