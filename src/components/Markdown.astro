---
import { renderMarkdown } from '../lib/markdown';
interface Props { content: string; }
---
<div class="rich-content" set:html={renderMarkdown(Astro.props.content)}/>
<style is:global>
  .rich-content { line-height:1.85; color:#596579; overflow-wrap:anywhere; }
  .rich-content > * + * { margin-top:1.3em; }
  .rich-content h1,.rich-content h2,.rich-content h3 { font-family:var(--font-sans); font-weight:600; letter-spacing:-.025em; line-height:1.3; color:var(--color-ink); margin-top:1.5em; }
  .rich-content > :first-child { margin-top:0; }
  .rich-content h1 { font-size:1.75rem; } .rich-content h2 { font-size:1.4rem; } .rich-content h3 { font-size:1.15rem; }
  .rich-content a { text-decoration:underline; text-underline-offset:3px; color:#0866ff; }
  .rich-content ul { list-style:disc; padding-left:1.5em; } .rich-content ol { list-style:decimal; padding-left:1.5em; }
  .rich-content li + li { margin-top:.4em; }
  .rich-content blockquote { border-left:3px solid #b5d6ff; padding:12px 20px; background:var(--color-surface); }
  .rich-content img { display:block; max-width:100%; height:auto; border-radius:8px; margin-block:1em; }
  .rich-content pre { overflow-x:auto; padding:16px; background:#f6f8fa; border-radius:8px; font-size:.85em; }
  .rich-content code { background:#f6f8fa; padding:2px 4px; border-radius:3px; }
  .rich-content table { display:block; overflow-x:auto; border-collapse:collapse; }
  .rich-content th,.rich-content td { border:1px solid #e3e8ee; padding:8px 12px; }
  .rich-content figure { margin-inline:0; }
  .rich-content iframe,.rich-content video { width:100%; aspect-ratio:16/9; border:0; border-radius:8px; background:#f6f8fa; }
  .rich-content figcaption { font-size:12px; margin-top:8px; }
</style>
