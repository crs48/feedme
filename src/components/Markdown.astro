---
import { renderMarkdown } from '../lib/markdown';
interface Props { content: string; }
---
<div class="rich-content" set:html={renderMarkdown(Astro.props.content)}/>
<style is:global>
  .rich-content { line-height:1.85; color:#616d61; overflow-wrap:anywhere; }
  .rich-content > * + * { margin-top:1.3em; }
  .rich-content h1,.rich-content h2,.rich-content h3 { font-family:var(--font-serif); line-height:1.2; color:var(--color-ink); margin-top:1.5em; }
  .rich-content h1 { font-size:2rem; } .rich-content h2 { font-size:1.7rem; } .rich-content h3 { font-size:1.35rem; }
  .rich-content a { text-decoration:underline; text-underline-offset:3px; color:#315e47; }
  .rich-content ul { list-style:disc; padding-left:1.5em; } .rich-content ol { list-style:decimal; padding-left:1.5em; }
  .rich-content li + li { margin-top:.4em; }
  .rich-content blockquote { border-left:3px solid #a3b58f; padding:8px 20px; font-style:italic; background:#f1f3eb; }
  .rich-content img { display:block; max-width:100%; height:auto; border-radius:12px; margin-block:1em; }
  .rich-content pre { overflow-x:auto; padding:16px; background:#edf0e7; border-radius:8px; font-size:.85em; }
  .rich-content code { background:#edf0e7; padding:2px 4px; border-radius:3px; }
  .rich-content table { display:block; overflow-x:auto; border-collapse:collapse; }
  .rich-content th,.rich-content td { border:1px solid #d5dbd1; padding:8px 12px; }
  .rich-content figure { margin-inline:0; }
  .rich-content iframe,.rich-content video { width:100%; aspect-ratio:16/9; border:0; border-radius:12px; background:#e8ecdf; }
  .rich-content figcaption { font-size:12px; margin-top:8px; }
</style>
