---
import type { Project } from '../lib/model';
interface Props { project?: Project; }
const { project: p } = Astro.props;
---
<form method="post" action="/api/studio">
  <input type="hidden" name="returnTo" value={p ? `/studio/projects/${p.id}` : "/studio/projects/new"}/>
  <input type="hidden" name="action" value="project"/>{p && <input type="hidden" name="id" value={p.id}/>}
  <label class="field">What are you making room for?<input name="title" minlength="3" maxlength="100" value={p?.title} required placeholder="A neighborhood repair café"/></label>
  <label class="field">A little introduction<textarea name="summary" minlength="10" maxlength="240" required rows="2" style="min-height:70px" placeholder="A sentence or two to invite people in.">{p?.summary}</textarea></label>
  <label class="field">Tell the story · Markdown supported<textarea name="description" minlength="10" maxlength="30000" required rows="5" placeholder="What matters about this? What would support make possible?">{p?.description}</textarea></label>
  <details class="text-xs muted mb-6"><summary>Formatting, images & video</summary><p class="mt-3">Use headings, lists, **bold**, [links](https://…), and ![image description](https://…/photo.jpg). Put a YouTube, Vimeo, MP4, or WebM link on its own paragraph to embed a video. Raw HTML is disabled.</p><p class="mt-2">Example: [A tour of the workshop](https://www.youtube.com/watch?v=VIDEO_ID)</p></details>
  <div class="form-grid"><label class="field">Category<select name="category">{['Making', 'Writing', 'Open source', 'Community', 'Life'].map((c) => <option selected={p?.category === c}>{c}</option>)}</select></label><label class="field">Type<select name="kind"><option value="project" selected={p?.kind !== 'ongoing'}>A project</option><option value="ongoing" selected={p?.kind === 'ongoing'}>An ongoing practice</option></select></label><label class="field">Aspiration in USD (optional)<input name="target" type="number" min="0" max="1000000" step="0.01" value={p ? p.target / 100 : 0}/></label><label class="field">Illustration<select name="color">{['peach', 'blue', 'green', 'yellow'].map((c) => <option selected={p?.color === c}>{c}</option>)}</select></label><label class="field">Image URL (HTTPS, optional)<input name="image" type="url" value={p?.image} placeholder="https://…"/></label><label class="field">Project link (HTTPS, optional)<input name="link" type="url" value={p?.link} placeholder="https://…"/></label></div>
  <label class="field">Status<select name="status">{(p && p.status !== 'draft' ? ['active', 'complete', 'archived'] : ['draft', 'active']).map((s) => <option value={s} selected={(p?.status || 'draft') === s}>{s === 'active' ? 'Published · accepting tips' : s === 'draft' ? 'Private draft' : s}</option>)}</select></label><p class="text-xs muted mb-5">An aspiration is a direction, not a condition. Supporters can tip without a funding deadline.</p>
  <button class="button">{p ? 'Save changes' : 'Create project'}</button>
</form>
