{
  "lexicon": 1,
  "id": "fund.feedme.update",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "id",
          "projectId",
          "text",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 36
          },
          "projectId": {
            "type": "string",
            "maxLength": 64
          },
          "text": {
            "type": "string",
            "maxLength": 8000,
            "maxGraphemes": 2000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "postUri": {
            "type": "string",
            "format": "at-uri",
            "description": "Optional reference to the creator\u2019s native app.bsky.feed.post. Render the current public post, including its media, instead of the legacy text snapshot."
          }
        }
      }
    }
  }
}
