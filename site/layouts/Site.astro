---
import '../../src/styles/global.css';
import '../styles/site.css';
import BrandIcon from '../../src/components/BrandIcon.astro';
import BrandMeta from '../../src/components/BrandMeta.astro';
interface Props { title?: string; description?: string; }
const { title = 'Feedme — make room for what matters', description = 'An open-source home for community support. Share what you’re working on, let people tip the projects they love, and see what they want more of.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><BrandMeta/><link rel="canonical" href={new URL(Astro.url.pathname, 'https://feedme.fund')}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(Astro.url.pathname, 'https://feedme.fund')}/><meta property="og:image" content="https://feedme.fund/social-card.png"/><meta property="og:image:type" content="image/png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Feedme: independent work, supported."/><meta name="twitter:image" content="https://feedme.fund/social-card.png"/><meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#ffffff"/></head><body class="product-site">
<a class="site-skip" href="#main">Skip to content</a>
<header class="product-nav wrap"><a class="product-brand" href="/" aria-label="Feedme home"><BrandIcon size={26}/>feedme</a><nav aria-label="Main navigation"><a class="creator-nav" href="/creators/">Creators</a><a class="libcard-nav" href="/libcard/" aria-current={Astro.url.pathname === "/libcard/" ? "page" : undefined}>LibCard</a><a href="/#how-it-works">How it works</a><a href="/get-started/">Set up yours</a><a href="https://github.com/crs48/feedme">GitHub ↗</a><a class="button" href="/demo/">Try the demo ↗</a></nav></header>
<main id="main"><slot/></main>
<footer class="product-footer wrap"><div><a class="product-brand" href="/"><BrandIcon size={26}/>feedme</a><p>Independent work, supported.<br/>Built by Christopher Smothers. Open to everyone.</p></div><div><a href="/creators/">Explore creators</a><a href="/demo/">Explore the demo</a><a href="/get-started/">Self-host Feedme</a><a href="/libcard/">LibCard integration</a><a href="/libcard/setup/">Connect your LibCard</a><a href="https://github.com/crs48/feedme">Source code · MIT</a><a href="https://bsky.app/profile/feedme.fund">@feedme.fund on Bluesky ↗</a></div><p class="footer-note">Work in progress. The demo uses fictional data and takes no payments. Live integrations require setup and testing.</p></footer>
</body></html>
