---
import Site from '../layouts/Site.astro';
import { directory } from '../lib/directory';
import { DAY, publicDirectoryCreators } from '../../src/lib/directory-model';
interface Props { page?: number; }
const { page = 1 } = Astro.props;
const creators = publicDirectoryCreators(directory.creators.map(c => ({ did: c.did, creator: c })), Date.now());
const perPage = 24;
const shown = creators.slice((page - 1) * perPage, page * perPage);
const pages = Math.max(1, Math.ceil(creators.length / perPage));
const hasScan = directory.source.completedAt || directory.source.relays.length;
const date = (value: string) => new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value));
const href = (n: number) => n === 1 ? '/creators/' : `/creators/page/${n}/`;
---
<Site title="Find your people · Feedme creators" description="Discover independent creators with their own Feedme. Explore their work, find your next connection, and support what you want to see more of.">
  <section class="directory-hero wrap">
    <p class="eyebrow">Independent homes. A shared community.</p>
    <h1>Good people.<br/><span>Things worth supporting.</span></h1>
    <p class="directory-intro">A growing directory of people making room for their ideas. Each creator runs their own Feedme, connected through AT Protocol.</p>
    <div class="directory-hero-actions"><a class="button" href="#join">Add your Feedme <span aria-hidden="true">↗</span></a><a class="text-link" href="/demo/discover/">Explore the demo community →</a></div>
  </section>
  <section class="wrap directory-body" aria-labelledby="creators-heading">
    <div class="directory-toolbar"><div><h2 id="creators-heading">Explore creators <span>{creators.length}</span></h2><p>Real public profiles, checked against their own websites.</p></div><a class="directory-data-link" href="/directory/v1.json">Public directory data ↗</a></div>
    {hasScan ? <p class="directory-freshness" data-directory-generated={directory.generatedAt}>Directory built <time datetime={directory.generatedAt}>{date(directory.generatedAt)} UTC</time>. {directory.source.partial ? 'Some profiles or sources could not be checked. Coverage is partial.' : 'Refreshed nightly; relay coverage can vary.'}<span data-directory-stale hidden={Date.now() - Date.parse(directory.generatedAt) < 2 * DAY}> This directory is due for a refresh. Check times below may be out of date.</span></p> : <p class="directory-freshness">The directory is waiting for its first public network scan.</p>}
    {creators.length > 0 && <form class="directory-search" role="search" hidden data-directory-search><label for="creator-search">Find a creator</label><div><input id="creator-search" type="search" placeholder="Name, Bluesky handle, or website" autocomplete="off" maxlength="253"/><button class="button secondary" type="reset">Clear</button></div><p aria-live="polite" data-search-count></p></form>}
    <div class="directory-grid" data-directory-grid>
      {shown.map(c => <article class="directory-card" data-creator-did={c.did}>
        <div class="directory-card-top"><span class="directory-avatar" aria-hidden="true">{Array.from(c.name.trim())[0]?.toUpperCase()}</span><span class:list={['directory-status', c.siteStatus !== 'reachable' && 'unavailable']}>{c.siteStatus === 'reachable' ? 'Website checked' : c.siteStatus === 'unreachable' ? 'Currently unreachable' : 'Needs a fresh check'}</span></div>
        <h3>{c.name}</h3><a class="directory-handle" href={`https://bsky.app/profile/${encodeURIComponent(c.did)}`} rel="noopener noreferrer">{c.handle ? `@${c.handle}` : 'View AT Protocol account ↗'}</a>
        <p class="directory-bio">{c.bio}</p>
        <div class="directory-card-bottom">{c.url ? <a class="button secondary" href={c.url} rel="noopener noreferrer">Visit Feedme ↗</a> : <span class="directory-no-link">Website link withheld until rechecked.</span>}<small>{c.lastVerifiedAt && <>Last verified <time datetime={c.lastVerifiedAt}>{date(c.lastVerifiedAt)} UTC</time></>}</small></div>
      </article>)}
    </div>
    {creators.length === 0 && <div class="directory-empty"><span aria-hidden="true">✳</span><h2>A little room to grow.</h2><p>{hasScan ? 'No verified creators are listed yet. If you already run a Feedme, publish your profile to let the network know you’re here.' : 'Once the first scan completes, public Feedme profiles will appear here automatically.'}</p><a class="button secondary" href="#join">Be part of the directory →</a></div>}
    <p class="directory-empty-search" data-empty-search hidden>No creators match that search. Try a name, full handle, or domain.</p>
    {pages > 1 && <nav class="directory-pagination" aria-label="Creator pages" data-directory-pagination>{page > 1 && <a class="button secondary" href={href(page - 1)}>← Previous</a>}<span>Page {page} of {pages}</span>{page < pages && <a class="button secondary" href={href(page + 1)}>Next →</a>}</nav>}
    <p class="directory-disclaimer">A website check confirms its public identity declaration, not payment readiness or an endorsement. This is a directory of known, discoverable profiles—not every AT Protocol account. <a href="https://github.com/crs48/feedme/issues/new">Report a listing</a>.</p>
  </section>
  <section class="wrap directory-how" id="join"><div><p class="eyebrow">Your corner belongs here</p><h2>Run your own Feedme.<br/>Let the network find you.</h2><p>No directory account or application form. Your identity and your website stay yours.</p><a class="button" href="/get-started/">Set up your Feedme ↗</a></div><ol><li><span>1</span><div><h3>Make yourself at home</h3><p>Host Feedme at your HTTPS address and sign in with your own Bluesky or AT Protocol account.</p></div></li><li><span>2</span><div><h3>Publish your profile</h3><p>Open Settings, review your public address, and save with “List my profile in Feedme discovery” enabled.</p></div></li><li><span>3</span><div><h3>We’ll take it from there</h3><p>The next successful nightly scan checks your PDS record and website. Turn discovery off to withdraw from future listings.</p></div></li></ol></section>
  <aside class="wrap directory-notes"><div><h2>Find people you already know</h2><p>Open Discover on your own Feedme to find mutuals, people you follow, followers, and friends of friends. Your personal connections stay with the instance you choose.</p></div><div><h2>Still missing from the directory?</h2><p>A relay may not have found your account yet. You can <a href="https://github.com/crs48/feedme/blob/main/directory/README.md">submit your DID as a discovery hint</a>. Every entry still goes through the same checks.</p></div></aside>
  <script id="directory-search-data" type="application/json" set:html={JSON.stringify(creators).replace(/</g, '\\u003c')} />
</Site>
<script>
  import '../scripts/directory-search';
</script>
<style is:global>
  .directory-hero{padding-top:64px;padding-bottom:56px;max-width:1160px}.directory-hero h1{font-size:clamp(38px,5vw,62px);line-height:1.08;letter-spacing:-.055em;margin:20px 0;font-weight:650}.directory-hero h1>span{color:#0866ff}.directory-intro{max-width:570px;color:#64748b;font-size:17px;line-height:1.8}.directory-hero-actions{display:flex;gap:24px;align-items:center;flex-wrap:wrap;margin-top:24px}.directory-hero-actions .text-link{margin:0}.directory-body{padding-bottom:60px}.directory-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;border-top:1px solid #e5ebf3;padding-top:30px}.directory-toolbar h2{font-size:21px;font-weight:600;letter-spacing:-.03em}.directory-toolbar h2 span{font-size:12px;background:#eef5ff;color:#0866ff;border-radius:20px;padding:4px 9px;margin-left:8px;vertical-align:middle}.directory-toolbar p,.directory-freshness{color:#64748b;font-size:12px;line-height:1.8;margin-top:6px}.directory-data-link{font-size:12px;color:#0866ff;min-height:44px;display:flex;align-items:center}.directory-freshness{margin-block:16px 24px}.directory-freshness [data-directory-stale]{color:#8a5714}.directory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.directory-card{padding:24px;border:1px solid #e2e9f2;border-radius:14px;display:flex;flex-direction:column;min-width:0;background:white}.directory-card-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.directory-avatar{display:grid;place-items:center;width:48px;height:48px;flex-shrink:0;border-radius:50%;background:linear-gradient(135deg,#dcecff,#eee4fa);color:#225eb0;font-size:21px;font-weight:600}.directory-status{font-size:10px;color:#327860;background:#edf8f2;border-radius:20px;padding:5px 8px}.directory-status.unavailable{background:#f4f5f7;color:#667085}.directory-card h3{font-size:19px;font-weight:600;letter-spacing:-.025em;overflow-wrap:anywhere}.directory-handle{font-size:12px;color:#0866ff;overflow-wrap:anywhere;margin-top:5px}.directory-bio{font-size:13px;line-height:1.8;color:#64748b;margin:16px 0 24px;flex:1;overflow-wrap:anywhere}.directory-card-bottom small{display:block;color:#718096;font-size:10px;line-height:1.7;margin-top:15px}.directory-no-link{font-size:12px;color:#64748b}.directory-disclaimer{font-size:11px;color:#718096;line-height:1.8;max-width:800px;margin-top:24px}.directory-disclaimer a,.directory-notes a{color:#0866ff;text-decoration:underline}.directory-empty{padding:55px 24px;text-align:center;border:1px dashed #cddcee;border-radius:16px;background:linear-gradient(145deg,#f8fbff,#fff)}.directory-empty>span{font-size:42px;color:#70a7f6;display:block;line-height:1;margin-bottom:18px}.directory-empty h2{font-size:25px;font-weight:600;letter-spacing:-.035em}.directory-empty p{max-width:460px;margin:14px auto 22px;font-size:14px;line-height:1.8;color:#64748b}.directory-how{display:grid;grid-template-columns:1fr 1fr;gap:70px;padding-block:55px;border-top:1px solid #e5ebf3;scroll-margin-top:24px}.directory-how h2{font-size:32px;line-height:1.2;font-weight:600;letter-spacing:-.04em;margin:15px 0}.directory-how p{font-size:14px;line-height:1.8;color:#64748b;max-width:420px}.directory-how .button{margin-top:22px}.directory-how ol{list-style:none;padding:0;display:grid;gap:24px}.directory-how li{display:flex;gap:16px}.directory-how li>span{border:1px solid #d9e5f3;width:28px;height:28px;display:grid;place-items:center;border-radius:50%;flex-shrink:0;font-size:12px;color:#0866ff}.directory-how h3{font-size:15px;font-weight:600;margin-bottom:5px}.directory-notes{display:grid;grid-template-columns:1fr 1fr;gap:70px;padding-bottom:70px}.directory-notes h2{font-size:15px;font-weight:600;margin-bottom:10px}.directory-notes p{font-size:13px;color:#64748b;line-height:1.8}.directory-search{margin-bottom:24px;max-width:600px}.directory-search label{font-size:12px;font-weight:600}.directory-search>div{display:flex;gap:8px;margin-top:8px}.directory-search input{min-width:0;flex:1;border:1px solid #dce5f1;border-radius:9px;padding:12px 14px;font-size:16px}.directory-search p{font-size:12px;color:#64748b;margin-top:8px}.directory-empty-search{padding:30px;color:#64748b;text-align:center}.directory-pagination{display:flex;justify-content:center;align-items:center;gap:18px;margin-top:26px;font-size:13px}.directory-search[hidden],.directory-pagination[hidden],.directory-empty-search[hidden]{display:none}@media(max-width:900px){.directory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.directory-how,.directory-notes{gap:30px}}@media(max-width:600px){.directory-hero{padding-block:35px}.directory-intro{font-size:15px}.directory-grid,.directory-how,.directory-notes{grid-template-columns:1fr}.directory-toolbar{align-items:flex-start;flex-direction:column;gap:5px}.directory-hero-actions{gap:10px}.directory-card{padding:20px}.directory-how{padding-block:35px}.directory-notes{padding-bottom:40px}.directory-how h2{font-size:28px}}
</style>
